<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_codestra_crm_call_delivery_reconcile" model="ir.cron">
            <field name="name">CRM Call Follow-up: Reconcile email delivery</field>
            <field name="model_id" ref="model_codestra_crm_call_delivery"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_mail_states()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_codestra_crm_call_delivery_retry" model="ir.cron">
            <field name="name">CRM Call Follow-up: Retry failed email delivery</field>
            <field name="model_id" ref="model_codestra_crm_call_delivery"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
