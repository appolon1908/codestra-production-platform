<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_codestra_crm_call_delivery_agent" model="ir.rule">
        <field name="name">Call deliveries: assigned agent</field>
        <field name="model_id" ref="model_codestra_crm_call_delivery"/>
        <field name="groups" eval="[(4, ref('codestra_crm_call_followup.group_call_followup_user'))]"/>
        <field name="domain_force">[('agent_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_codestra_crm_call_delivery_manager" model="ir.rule">
        <field name="name">Call deliveries: manager company scope</field>
        <field name="model_id" ref="model_codestra_crm_call_delivery"/>
        <field name="groups" eval="[(4, ref('codestra_crm_call_followup.group_call_followup_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
