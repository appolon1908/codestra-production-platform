<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_call_followup" model="ir.ui.view">
        <field name="name">crm.lead.form.call.followup</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_codestra_call_followups"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-phone"
                        groups="codestra_crm_call_followup.group_call_followup_user">
                    <field name="codestra_call_followup_count" widget="statinfo" string="Call Follow-ups"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="codestra_next_callback_at"
                       readonly="1"
                       groups="codestra_crm_call_followup.group_call_followup_user"/>
            </xpath>
        </field>
    </record>
</odoo>
