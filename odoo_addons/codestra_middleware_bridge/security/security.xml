<odoo>
  <record id="group_codestra_middleware_bridge" model="res.groups">
    <field name="name">Codestra Middleware Bridge</field>
    <field name="comment">Non-interactive least-privilege identity for the signed middleware API.</field>
  </record>
  <record id="group_codestra_crm_api" model="res.groups">
    <field name="name">Codestra CRM API Service</field>
    <field name="comment">Dedicated non-interactive identity for tenant-scoped CRM operations.</field>
  </record>

  <record id="rule_codestra_crm_mapping_service" model="ir.rule">
    <field name="name">CRM API mappings limited to service identity</field>
    <field name="model_id" ref="model_codestra_crm_external_mapping"/>
    <field name="domain_force">[("service_user_id", "=", user.id)]</field>
    <field name="groups" eval="[(4, ref('codestra_middleware_bridge.group_codestra_crm_api'))]"/>
  </record>
</odoo>
