<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_codestra_crm_call_followup_report_search" model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.report.search</field>
        <field name="model">codestra.crm.call.followup.report</field>
        <field name="arch" type="xml">
            <search string="Post-call Performance">
                <field name="followup_id"/>
                <field name="agent_id"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <filter name="overdue" string="Overdue SLA" domain="[('is_overdue', '=', True)]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter name="compliance" string="Compliance Review" domain="[('compliance_review_required', '=', True)]"/>
                <filter name="scheduled" string="Scheduled" domain="[('schedule_kind', '!=', 'none')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_day" string="Call Date" context="{'group_by': 'ended_at:day'}"/>
                    <filter name="group_week" string="Call Week" context="{'group_by': 'ended_at:week'}"/>
                    <filter name="group_outcome" string="Outcome" context="{'group_by': 'disposition'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_sentiment" string="Sentiment" context="{'group_by': 'customer_sentiment'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'call_direction'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_codestra_crm_call_followup_report_list" model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.report.list</field>
        <field name="model">codestra.crm.call.followup.report</field>
        <field name="arch" type="xml">
            <list string="Post-call Performance"
                  create="0"
                  edit="0"
                  delete="0"
                  decoration-danger="is_overdue or compliance_review_required"
                  decoration-warning="state == 'pending' and not is_overdue"
                  decoration-success="state == 'completed' and not compliance_review_required">
                <field name="ended_at"/>
                <field name="agent_id"/>
                <field name="partner_id" optional="show"/>
                <field name="lead_id" optional="show"/>
                <field name="call_direction" optional="hide"/>
                <field name="priority" widget="badge" optional="show"
                       decoration-info="priority == 'normal'"
                       decoration-warning="priority == 'high'"
                       decoration-danger="priority == 'urgent'"/>
                <field name="disposition" optional="show"/>
                <field name="customer_sentiment" optional="show"/>
                <field name="pending_age_minutes" string="Pending Age (min)" optional="show"/>
                <field name="post_call_completion_minutes" string="Completion (min)" optional="show"/>
                <field name="schedule_kind" optional="hide"/>
                <field name="callback_at" optional="hide"/>
                <field name="is_overdue" optional="show"/>
                <field name="compliance_review_required" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
                <button name="action_open_followup"
                        type="object"
                        string="Open Call"
                        class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_codestra_crm_call_followup_report_pivot" model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.report.pivot</field>
        <field name="model">codestra.crm.call.followup.report</field>
        <field name="arch" type="xml">
            <pivot string="Post-call Performance" disable_linking="1">
                <field name="ended_at" type="row" interval="day"/>
                <field name="agent_id" type="row"/>
                <field name="disposition" type="col"/>
                <field name="call_count" type="measure"/>
                <field name="overdue_count" type="measure"/>
                <field name="compliance_count" type="measure"/>
                <field name="scheduled_count" type="measure"/>
                <field name="email_queued_count" type="measure"/>
                <field name="post_call_completion_minutes" type="measure"/>
                <field name="call_duration_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_codestra_crm_call_followup_report_graph" model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.report.graph</field>
        <field name="model">codestra.crm.call.followup.report</field>
        <field name="arch" type="xml">
            <graph string="Post-call Outcomes" type="bar" stacked="1">
                <field name="agent_id"/>
                <field name="disposition"/>
                <field name="call_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_codestra_crm_call_followup_report" model="ir.actions.act_window">
        <field name="name">Post-call Performance</field>
        <field name="res_model">codestra.crm.call.followup.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_codestra_crm_call_followup_report_search"/>
        <field name="context">{'search_default_group_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No completed-call data is available.</p>
            <p>This read-only report measures call volume, post-call completion time, scheduling, email queueing, and compliance workload.</p>
        </field>
    </record>

    <record id="action_codestra_crm_call_followup_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Post-call Actions</field>
        <field name="res_model">codestra.crm.call.followup.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_codestra_crm_call_followup_report_search"/>
        <field name="domain">[('is_overdue', '=', True)]</field>
        <field name="context">{'search_default_group_agent': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No post-call actions are outside the 10-minute SLA.</p>
            <p>Only unsnoozed pending actions appear here. Open the call record to review the responsible agent and customer context.</p>
        </field>
    </record>

    <menuitem id="menu_codestra_crm_call_followup_report"
              name="Post-call Performance"
              parent="crm.crm_menu_report"
              action="action_codestra_crm_call_followup_report"
              sequence="10"
              groups="codestra_crm_call_followup.group_call_followup_manager"/>

    <menuitem id="menu_codestra_crm_call_followup_overdue"
              name="Overdue Call Actions"
              parent="crm.crm_menu_report"
              action="action_codestra_crm_call_followup_overdue"
              sequence="11"
              groups="codestra_crm_call_followup.group_call_followup_manager"/>
</odoo>
