<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_codestra_call_followup_outbox_search"
            model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.outbox.search</field>
        <field name="model">codestra.crm.call.followup.outbox</field>
        <field name="arch" type="xml">
            <search string="Call Automation Outbox">
                <field name="event_id"/>
                <field name="idempotency_key"/>
                <field name="followup_id"/>
                <field name="event_type"/>
                <filter name="needs_attention"
                        string="Needs Attention"
                        domain="['|', ('state', '=', 'pending'), ('state', 'in', ['retry', 'dead'])]"/>
                <filter name="pending"
                        string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="retry"
                        string="Retry"
                        domain="[('state', '=', 'retry')]"/>
                <filter name="dead"
                        string="Dead Letter"
                        domain="[('state', '=', 'dead')]"/>
                <filter name="delivered"
                        string="Delivered"
                        domain="[('state', '=', 'delivered')]"/>
                <group>
                    <filter name="group_state"
                            string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type"
                            string="Event Type"
                            context="{'group_by': 'event_type'}"/>
                    <filter name="group_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_codestra_call_followup_outbox_list"
            model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.outbox.list</field>
        <field name="model">codestra.crm.call.followup.outbox</field>
        <field name="arch" type="xml">
            <list string="Call Automation Outbox"
                  create="0"
                  edit="0"
                  delete="0"
                  decoration-warning="state in ['pending', 'retry']"
                  decoration-danger="state == 'dead'"
                  decoration-success="state == 'delivered'">
                <field name="occurred_at"/>
                <field name="event_type"/>
                <field name="followup_id"/>
                <field name="company_id"
                       groups="base.group_multi_company"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="last_http_status"
                       optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-warning="state in ['pending', 'retry']"
                       decoration-danger="state == 'dead'"
                       decoration-success="state == 'delivered'"/>
                <button name="action_retry_now"
                        type="object"
                        string="Retry Now"
                        class="btn-link"
                        invisible="state not in ['retry', 'dead']"/>
            </list>
        </field>
    </record>

    <record id="view_codestra_call_followup_outbox_form"
            model="ir.ui.view">
        <field name="name">codestra.crm.call.followup.outbox.form</field>
        <field name="model">codestra.crm.call.followup.outbox</field>
        <field name="arch" type="xml">
            <form string="Call Automation Event"
                  create="0"
                  edit="0"
                  delete="0">
                <header>
                    <button name="action_retry_now"
                            type="object"
                            string="Retry Now"
                            class="btn-primary"
                            invisible="state not in ['retry', 'dead']"/>
                    <button name="action_mark_dead"
                            type="object"
                            string="Move to Dead Letter"
                            class="btn-secondary"
                            invisible="state in ['delivered', 'dead']"
                            confirm="Stop automatic retries for this event?"/>
                    <button name="action_open_followup"
                            type="object"
                            string="Open Call Follow-up"
                            class="btn-secondary"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,processing,retry,delivered,dead"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="event_id"/>
                        <h1><field name="event_id"/></h1>
                    </div>
                    <group>
                        <group string="Event">
                            <field name="event_type"/>
                            <field name="event_version"/>
                            <field name="occurred_at"/>
                            <field name="company_id"/>
                            <field name="followup_id"/>
                            <field name="calendar_event_id"/>
                            <field name="correlation_id"/>
                            <field name="idempotency_key"/>
                            <field name="payload_sha256"/>
                        </group>
                        <group string="Delivery">
                            <field name="priority"/>
                            <field name="attempt_count"/>
                            <field name="max_attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="locked_at"/>
                            <field name="lease_token"/>
                            <field name="delivered_at"/>
                            <field name="last_http_status"/>
                            <field name="response_body_sha256"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_codestra_call_followup_outbox"
            model="ir.actions.act_window">
        <field name="name">Automation Outbox</field>
        <field name="res_model">codestra.crm.call.followup.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_codestra_call_followup_outbox_search"/>
        <field name="context">{'search_default_needs_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No call automation events need attention.
            </p>
            <p>
                Post-call changes are captured transactionally and delivered
                asynchronously to Codestra middleware.
            </p>
        </field>
    </record>

    <menuitem id="menu_codestra_call_followup_outbox"
              name="Automation Outbox"
              parent="crm.crm_menu_report"
              action="action_codestra_call_followup_outbox"
              sequence="30"
              groups="codestra_crm_call_followup.group_call_followup_manager"/>
</odoo>
