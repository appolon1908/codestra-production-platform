-- Reviewed least-privilege contract. Replace identifiers only via deployment manifest.
-- The owning migration role is deliberately distinct from the NOLOGIN runtime group.
CREATE ROLE codestra_middleware_runtime NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA middleware TO codestra_middleware_runtime;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA middleware TO codestra_middleware_runtime;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA middleware TO codestra_middleware_runtime;
REVOKE DELETE, TRUNCATE ON ALL TABLES IN SCHEMA middleware FROM codestra_middleware_runtime;
