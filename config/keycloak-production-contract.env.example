# Non-secret production identity contract. Secret values are file-mounted.
KEYCLOAK_ISSUER=https://auth.codestra.agency/realms/codestra
KEYCLOAK_AUDIENCE=codestra-middleware
KEYCLOAK_CLIENT_ID=codestra-middleware-production
KEYCLOAK_CLIENT_SECRET_FILE=/run/secrets/keycloak_middleware_production
KEYCLOAK_REQUIRED_ROLE=middleware_service
KEYCLOAK_MAX_TOKEN_TTL_SECONDS=300
KEYCLOAK_ALLOWED_TENANTS_FILE=/etc/codestra/production-tenant-allowlist.json
PROVISIONING_SERVICE_CLIENT_ID=codestra-client-provisioner
PROVISIONING_SERVICE_CLIENT_SECRET_FILE=/run/secrets/keycloak_client_provisioner

