# Compatibility example only. The canonical production source is
# operations/caddy/auth.codestra.co.caddy.
# Caddy owns ACME issuance and renewal; do not add `tls internal`.
auth.codestra.co {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	encode gzip
	reverse_proxy keycloak:8080
}
