{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.co/schemas/server-a-operator-installation-record.v1.json",
  "title": "Server A operator installation approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mode", "reference_release", "target_release", "operator_public_key_fingerprint", "arguments"],
  "properties": {
    "schema_version": {"const": "codestra.server-a-operator-installation-record.v1"},
    "status": {"enum": ["incomplete", "approved"]},
    "mode": {"const": "preserve-existing-sudoers"},
    "reference_release": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_commit", "release_archive_sha256", "release_manifest_sha256", "installer_sha256", "approval"],
      "properties": {
        "protected_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "release_archive_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "release_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "installer_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "approval": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "operator_public_key_fingerprint": {"$ref": "#/$defs/value"},
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_public_key", "protected_commit", "image_digest", "change_id", "maintenance_date", "control_plane_archive_sha256"],
      "properties": {
        "operator_public_key": {"$ref": "#/$defs/value"},
        "protected_commit": {"$ref": "#/$defs/value"},
        "image_digest": {"$ref": "#/$defs/value"},
        "change_id": {"$ref": "#/$defs/value"},
        "maintenance_date": {"$ref": "#/$defs/value"},
        "control_plane_archive_sha256": {"$ref": "#/$defs/value"}
      }
    }
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "approval"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1},
        "approval": {"type": ["string", "null"]}
      }
    }
  }
}
