# Canonical TEST_SYN webphone/provisioning machine identity. Non-secret.
KEYCLOAK_ISSUER=https://auth.codestra.co/realms/codestra
KEYCLOAK_TOKEN_ENDPOINT=https://auth.codestra.co/realms/codestra/protocol/openid-connect/token
KEYCLOAK_AUDIENCE=codestra-provisioning-service
KEYCLOAK_CLIENT_ID=codestra-provisioning-service-staging
KEYCLOAK_PROTOCOL=openid-connect
KEYCLOAK_PUBLIC_CLIENT=false
KEYCLOAK_BEARER_ONLY=false
KEYCLOAK_CLIENT_AUTHENTICATOR_TYPE=client-secret
KEYCLOAK_CLIENT_AUTH_METHOD=client_secret_post
KEYCLOAK_CLIENT_SECRET_FILE=/run/secrets/provisioning/client_secret
KEYCLOAK_REQUIRED_REALM_ROLES=
KEYCLOAK_REQUIRED_CLIENT_ROLES=realm-management:view-users
KEYCLOAK_REQUIRED_SCOPES=identity:rotate provisioning:execute provisioning:read
KEYCLOAK_MAX_TOKEN_TTL_SECONDS=300
KEYCLOAK_DEFAULT_CLIENT_SCOPES=
KEYCLOAK_OPTIONAL_CLIENT_SCOPES=
KEYCLOAK_ALLOWED_TENANTS_FILE=/etc/codestra/contracts/keycloak-webphone-allowed-tenants.json
KEYCLOAK_EXPECTED_AZP=codestra-provisioning-service-staging
KEYCLOAK_TENANT_MAPPER_REQUIRED=false
TENANT_BINDING_REQUIRED=true
TENANT_BINDING_AUTHORITY=canonical-browser-subject-and-odoo-identity-lookup
SERVICE_ACCOUNTS_ENABLED=true
STANDARD_FLOW_ENABLED=false
DIRECT_ACCESS_GRANTS_ENABLED=false
IMPLICIT_FLOW_ENABLED=false
FULL_SCOPE_ALLOWED=false
GRANT_TYPE=client_credentials
TEST_SYN_ONLY=true
PRODUCTION_DELIVERY_ALLOWED=false
