# Safe template only. Runtime credentials and certificate material stay outside Git.
ENVIRONMENT=staging
BUSINESS_UNIT=TEST
CANONICAL_CAMPAIGN=TEST-E2E-OUT
VICIDIAL_CAMPAIGN=TST00000
VICIDIAL_LIST_ID=91000
TEST_AGENT=TST6101
TEST_ENDPOINT=6101
ADAPTER_URL=https://edge.internal.codestra.agency:8443/restricted-vicidial
ADAPTER_CA_FILE=/run/secrets/vicidial-mtls/ca.crt
ADAPTER_CLIENT_CERT_FILE=/run/secrets/vicidial-mtls/client.crt
ADAPTER_CLIENT_KEY_FILE=/run/secrets/vicidial-mtls/client.key
ADAPTER_HMAC_FILE=/run/secrets/vicidial-adapter-hmac
INTEGRATION_UUID=00000000-0000-4000-8000-000000000001
ODOO_CAMPAIGN_ID=910001
OWNER_USER_ID=9101
SUPERVISOR_USER_ID=9102
CORRELATION_ID=synthetic-e2e-example
N8N_WORKFLOW_ACTIVE=false
LEAD_PUBLICATION=false
AGENT_SYNC=false
LIVE_CALL_CONTROL=false
PRODUCTION_DIALING=false
EXTERNAL_COMMUNICATION=false
