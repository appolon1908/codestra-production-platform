{
  "schema_version": 1,
  "approved_root": "/etc/codestra/secrets",
  "environment_file": {
    "path": "/etc/codestra/secrets/control-plane.env",
    "owner": "root:root",
    "mode": "0600",
    "atomic_group": "control-plane-email-authorities"
  },
  "secrets": [
    {
      "secret_id": "ODOO_OUTBOUND_HMAC_SECRET",
      "authority": "control-plane-to-odoo request authentication",
      "consumers": [
        "codestra-integration-control-plane-api-1",
        "codestra-integration-control-plane-worker-1",
        "odoo:codestra.webhook_secret"
      ],
      "new_auth_check": "validate-control-plane-odoo-hmac new",
      "old_auth_check": "validate-control-plane-odoo-hmac old --expect-rejected"
    },
    {
      "secret_id": "KLYROW_WEBHOOK_SECRET",
      "authority": "Klyrow-to-middleware webhook authentication",
      "consumers": [
        "codestra-integration-control-plane-api-1",
        "codestra-integration-control-plane-worker-1",
        "klyrow-private-webhook-authority"
      ],
      "new_auth_check": "validate-klyrow-webhook-hmac new",
      "old_auth_check": "validate-klyrow-webhook-hmac old --expect-rejected"
    }
  ],
  "rollout": {
    "success_order": [
      "verify successor inputs are root-owned mode 0600 regular files",
      "capture encrypted rollback material outside repository evidence",
      "stage successor authorities at every producer and verifier",
      "atomically replace both environment keys in one fsync and rename",
      "recreate only the declared consumers with delivery switches false",
      "prove health and new-key acceptance",
      "revoke predecessors at every authority",
      "prove old-key rejection",
      "write sanitized evidence without values"
    ],
    "rollback_order": [
      "keep delivery switches false",
      "restore the complete environment file atomically",
      "restore predecessor verifier authorities",
      "recreate only the declared consumers",
      "prove health and predecessor acceptance",
      "record sanitized rollback evidence"
    ],
    "required_evidence": [
      "file ownership and mode before and after",
      "consumer image IDs before and after",
      "delivery kill-switch read-back",
      "new-key acceptance result",
      "old-key rejection result",
      "rollback readiness",
      "timestamps and non-secret correlation IDs"
    ]
  }
}
