# Staging must use its separate Keycloak instance, secret and synthetic tenant.
KEYCLOAK_ISSUER=https://auth-staging.internal.codestra.agency/realms/codestra-staging
KEYCLOAK_AUDIENCE=codestra-middleware-staging
KEYCLOAK_CLIENT_ID=codestra-provisioning-service-staging
KEYCLOAK_CLIENT_SECRET_FILE=/run/secrets/keycloak_provisioning_staging
KEYCLOAK_REQUIRED_ROLE=middleware_staging_service
KEYCLOAK_MAX_TOKEN_TTL_SECONDS=300
KEYCLOAK_ALLOWED_TENANTS_FILE=/etc/codestra/staging-synthetic-tenant-allowlist.json
STAGING_ONLY=true
PRODUCTION_DELIVERY_ALLOWED=false
