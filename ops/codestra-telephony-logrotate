/var/log/asterisk/full /var/log/asterisk/messages /var/log/astguiclient/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 asterisk asterisk
    sharedscripts
    postrotate
        /usr/bin/systemctl kill -s HUP asterisk.service >/dev/null 2>&1 || true
    endscript
}

