[Unit]
Description=Codestra TEL-EVENTS finalized VICIdial call-ended publisher
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=codestra-events
Group=codestra-events
WorkingDirectory=/opt/codestra-tel-events
EnvironmentFile=/etc/codestra/tel-events-publisher.env
ExecStartPre=/usr/bin/test "$TEL_EVENTS_ENABLED" = true
ExecStartPre=/usr/bin/test "$SEND_EVENTS" = true
ExecStartPre=/usr/bin/test "$TEL_EVENTS_MODE" = production
ExecStartPre=/usr/bin/test ! -e ${DELIVERY_KILL_SWITCH}
ExecStart=/usr/bin/python3.11 -m tel_events.service --loop
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/codestra-tel-events
UMask=0077

[Install]
WantedBy=multi-user.target
