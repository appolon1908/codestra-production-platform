CODESTRA_ADAPTER_BACKEND=memory
CODESTRA_ADAPTER_HMAC_FILE=/run/credentials/codestra-vicidial-restricted-adapter.service/adapter-hmac
CODESTRA_VICIDIAL_DB_FILE=/run/secrets/vicidial-db.json
CODESTRA_ADAPTER_STATE=/var/lib/codestra-vicidial-restricted-adapter/state.sqlite3
CODESTRA_ADAPTER_IDENTITY=codestra-middleware
AUTHORIZED_APPLICATION_SERVER_IP=65.109.65.169
AUTHORIZED_PRIVATE_SOURCE_IP=10.40.0.1
MIDDLEWARE_BASE_URL=https://api.codestra.agency
KEYCLOAK_ISSUER_URL=https://auth.codestra.agency
CODESTRA_ENVIRONMENT=staging
CODESTRA_KEYCLOAK_ISSUER=https://identity.internal.codestra.agency/realms/codestra
CODESTRA_TELEPHONY_AUDIENCE=codestra-telephony-adapter
CODESTRA_KEYCLOAK_ALGORITHMS=RS256
CODESTRA_APPROVED_TELEPHONY_SUBJECTS=codestra-middleware,codestra-provisioning
CODESTRA_KEYCLOAK_VERIFICATION_KEY_FILE=/run/secrets/keycloak-verification-key.pem
CODESTRA_EXECUTION_GRANT_KEY_FILE=/run/secrets/telephony-execution-grant-key
CODESTRA_TELEPHONY_RESOURCE_ALLOWLIST=

# Global kill switch and every mutation family default disabled.
ENABLE_VICIDIAL_WRITES=false
ENABLE_PROVISIONING=false
ENABLE_AGENT_SYNC=false
ENABLE_LEAD_PUBLICATION=false
ENABLE_LIVE_CALL_CONTROL=false
ENABLE_IVR_ROUTING=false
ENABLE_IVR_CALLBACKS=false
ENABLE_WARM_TRANSFER=false
ENABLE_PRODUCTION_DIALING=false
ENABLE_EMAIL_DELIVERY=false
ENABLE_SMS_DELIVERY=false
ENABLE_AI_ACTIONS=false

# Independent private API capabilities and action gates.
ADAPTER_API_ENABLED=false
VICIDIAL_READS_ENABLED=false
ASTERISK_READS_ENABLED=false
RECONCILIATION_ENABLED=false
METRICS_ENABLED=false
VICIDIAL_USER_WRITES_ENABLED=false
VICIDIAL_PHONE_WRITES_ENABLED=false
VICIDIAL_CAMPAIGN_WRITES_ENABLED=false
VICIDIAL_LEAD_WRITES_ENABLED=false
ASTERISK_ENDPOINT_WRITES_ENABLED=false
ASTERISK_CONTACT_REVOCATION_ENABLED=false
ASTERISK_RELOAD_ENABLED=false
INTERNAL_CALLS_ENABLED=false
CALL_HANGUP_ENABLED=false
CALL_DTMF_ENABLED=false
CALL_HOLD_ENABLED=false
CALL_RESUME_ENABLED=false
TRANSFERS_ENABLED=false
EXTERNAL_CALLS_ENABLED=false
CUSTOMER_CALLS_ENABLED=false
TELEPHONY_ADAPTER_LOCAL_KILL_SWITCH=true
