# Never place real credentials in this file.
ODOO_CALL_FOLLOWUP_IMAGE=ghcr.io/appolon1908-hue/codestra-odoo-call-followup@sha256:<64-lowercase-hex>
ODOO_CALL_FOLLOWUP_RELEASE_SHA=<exact-approved-40-character-git-sha>
ODOO_DATABASE=<exact-odoo-database>
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=1
ODOO_GEVENT_PORT=8072

# Colon-separated Compose base files. Production defaults to
# deploy/odoo/compose.production.yaml; staging must be explicit.
BASE_COMPOSE_FILES=deploy/odoo/compose.production.yaml
MODULE_OPERATION=install

# Optional secret overlay. Mounting secrets does not enable remote delivery.
INCLUDE_AUTOMATION_SECRETS=NO
ODOO_CALL_FOLLOWUP_AUTOMATION_API_KEY_FILE=/etc/codestra/secrets/call-followup/api_key
ODOO_CALL_FOLLOWUP_AUTOMATION_WEBHOOK_SECRET_FILE=/etc/codestra/secrets/call-followup/webhook_secret

# Evidence and production gates.
APPROVED_HEAD_SHA=<same-exact-approved-40-character-git-sha>
REQUIRED_CHECKS=PASS
INDEPENDENT_REVIEW=APPROVED
STAGING_ACCEPTANCE=PASS
ROLLBACK_REHEARSAL=PASS
DATABASE_BACKUP_ID=<verified-backup-id>
FILESTORE_BACKUP_ID=<verified-backup-id>
CHANGE_ID=<approved-change-id>
ROLLBACK_IMAGE=<previous-repository-at-sha256-reference>
ROLLBACK_APP_SHA=<previous-40-character-git-sha>
ALLOW_PRODUCTION_DEPLOY=NO
PRODUCTION_CONFIRMATION=
