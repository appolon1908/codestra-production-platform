# Installed as /etc/codestra/tel-events-publisher.env; no secrets belong here.
TEL_EVENTS_ENABLED=false
SEND_EVENTS=false
TEL_EVENTS_MODE=disabled
TEL_EVENTS_EVENT_BUDGET=10
TEL_EVENTS_INTERVAL_SECONDS=15
TEL_EVENTS_CAMPAIGN_ALLOWLIST=
TEL_EVENTS_USER_GROUP_ALLOWLIST=
DELIVERY_KILL_SWITCH=/etc/codestra/disable-external-delivery
TEL_EVENTS_WATERMARK=/opt/codestra-tel-events/production-call-ended-watermark.json
TEL_EVENTS_LEDGER=/var/lib/codestra-tel-events/delivery.sqlite
TEL_EVENTS_ENDPOINT=https://middleware.internal.codestra.agency/api/v1/events/vicidial
TEL_EVENTS_CLIENT_INSTANCE=tel-events-production
TEL_EVENTS_HMAC_FILE=/etc/codestra/secrets/tel-events-callback-hmac
TEL_EVENTS_CA_FILE=/etc/codestra/secrets/middleware-event-mtls/ca.crt
TEL_EVENTS_CERT_FILE=/etc/codestra/secrets/middleware-event-mtls/client.crt
TEL_EVENTS_KEY_FILE=/etc/codestra/secrets/middleware-event-mtls/client.key
VICIDIAL_DB_HOST=127.0.0.1
VICIDIAL_DB_PORT=3306
VICIDIAL_DB_NAME=asterisk
VICIDIAL_DB_USER=codestra-tel-events
VICIDIAL_DB_PASS_FILE=/etc/codestra/secrets/tel-events-db-pass
