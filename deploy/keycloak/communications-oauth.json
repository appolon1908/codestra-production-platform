{
  "realm": "codestra",
  "issuer": "https://auth.codestra.co/realms/codestra",
  "audience": "codestra-middleware",
  "access_token_lifespan_seconds": 300,
  "tenant_claim": {"name": "tenant_id", "source": "server", "value": "COD"},
  "scopes": [
    "communications.message.create", "communications.message.read",
    "communications.message.dispatch", "communications.message.events.read",
    "communications.sms.create", "communications.sms.dispatch",
    "communications.sms.events.read", "communications.email.create",
    "communications.email.dispatch", "communications.email.events.read",
    "communications.result.write", "communications.reconciliation.read",
    "communications.reconciliation.execute", "communications.admin"
  ],
  "clients": {
    "codestra-odoo-communications": [
      "communications.message.create", "communications.message.read",
      "communications.message.events.read"
    ],
    "codestra-n8n-communications": [
      "communications.message.read", "communications.message.dispatch",
      "communications.message.events.read", "communications.result.write",
      "communications.sms.dispatch", "communications.sms.events.read",
      "communications.email.dispatch", "communications.email.events.read"
    ],
    "codestra-communication-worker": [
      "communications.message.read", "communications.sms.dispatch",
      "communications.sms.events.read", "communications.email.dispatch",
      "communications.email.events.read", "communications.reconciliation.read",
      "communications.reconciliation.execute"
    ]
  },
  "secret_files": "/etc/codestra/secrets/communications-oauth/<client-id>.secret"
}
