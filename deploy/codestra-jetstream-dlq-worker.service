[Unit]
Description=Codestra JetStream dead-letter forwarding worker
After=network-online.target nats-server.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/codestra/jetstream-dlq-worker.env
ExecStart=/usr/bin/docker run --rm --name codestra-jetstream-dlq-worker --network host --read-only --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=16m --env-file /etc/codestra/jetstream-dlq-worker.env --mount type=bind,src=/run/codestra/nats,dst=/run/codestra/nats,readonly ${MIDDLEWARE_IMAGE} python -m app.entrypoints.jetstream_dlq_worker
ExecStop=/usr/bin/docker stop --time 30 codestra-jetstream-dlq-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
