FROM python:3.12-alpine
RUN addgroup -S codestra && adduser -S -G codestra codestra \
 && pip install --no-cache-dir fastapi==0.141.1 uvicorn==0.35.0 PyJWT[crypto]==2.13.0
WORKDIR /app
COPY mail_platform /app/mail_platform
USER codestra
EXPOSE 8098
CMD ["uvicorn", "mail_platform.api:app", "--host", "0.0.0.0", "--port", "8098", "--proxy-headers", "--forwarded-allow-ips", "*"]
