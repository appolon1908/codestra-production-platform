{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.codestra.co/platform/platform-release-manifest.v1.schema.json",
  "title": "Codestra Platform Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "created_at", "authority", "contracts", "runtime", "services", "edge", "promotion", "evidence"],
  "properties": {
    "schema_version": {"const": "platform-release-manifest.v1"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_sha"],
      "properties": {
        "repository": {"const": "appolon1908-hue/codestra-production-platform"},
        "git_sha": {"$ref": "#/$defs/git_sha"}
      }
    },
    "contracts": {
      "allOf": [
        {"$ref": "#/$defs/pinned_file"},
        {"properties": {"path": {"const": "contracts/catalog.v1.json"}}}
      ]
    },
    "runtime": {
      "allOf": [
        {"$ref": "#/$defs/pinned_file"},
        {"properties": {"path": {"const": "composition/runtime-composition.v1.json"}}}
      ]
    },
    "services": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "allOf": [
        {"contains": {"properties": {"service_id": {"const": "caddy"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "kong"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "middleware"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "odoo-19"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "n8n"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "keycloak"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "kyqra-crawler"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "observability"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "postgresql"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "redis"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "nats-jetstream"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "temporal"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "telnexa"}}, "required": ["service_id"]}},
        {"contains": {"properties": {"service_id": {"const": "klyrow"}}, "required": ["service_id"]}}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id", "repository", "git_sha", "image", "service_manifest_sha256"],
        "allOf": [
          {
            "if": {"properties": {"service_id": {"enum": ["caddy", "kong", "observability", "postgresql", "redis"]}}},
            "then": {"properties": {"repository": {"const": "appolon1908-hue/codestra-production-platform"}}}
          },
          {
            "if": {"properties": {"service_id": {"enum": ["middleware", "nats-jetstream", "temporal"]}}},
            "then": {"properties": {"repository": {"const": "appolon1908-hue/Middleware-"}}}
          },
          {"if": {"properties": {"service_id": {"const": "odoo-19"}}}, "then": {"properties": {"repository": {"const": "appolon1908-hue/Odoo"}}}},
          {"if": {"properties": {"service_id": {"const": "n8n"}}}, "then": {"properties": {"repository": {"const": "appolon1908-hue/N8N"}}}},
          {"if": {"properties": {"service_id": {"const": "keycloak"}}}, "then": {"properties": {"repository": {"const": "appolon1908-hue/Keycloak"}}}},
          {"if": {"properties": {"service_id": {"const": "kyqra-crawler"}}}, "then": {"properties": {"repository": {"const": "appolon1908-hue/kyqra-crawler"}}}},
          {"if": {"properties": {"service_id": {"const": "telnexa"}}}, "then": {"properties": {"repository": {"const": "appolon1908-hue/telnexa"}}}},
          {"if": {"properties": {"service_id": {"const": "klyrow"}}}, "then": {"properties": {"repository": {"const": "appolon1908-hue/klyrow.com"}}}}
        ],
        "properties": {
          "service_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "repository": {"type": "string", "pattern": "^appolon1908-hue/[A-Za-z0-9._-]+$"},
          "git_sha": {"$ref": "#/$defs/git_sha"},
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "digest"],
            "properties": {
              "reference": {"type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9._/-]+$"},
              "digest": {"$ref": "#/$defs/image_digest"}
            }
          },
          "service_manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caddy", "kong"],
      "properties": {
        "caddy": {"$ref": "#/$defs/pinned_file"},
        "kong": {"$ref": "#/$defs/pinned_file"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging", "production", "identical_digests_required"],
      "properties": {
        "identical_digests_required": {"const": true},
        "staging": {"$ref": "#/$defs/environment_gate"},
        "production": {"$ref": "#/$defs/production_gate"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "production": {
                "properties": {"status": {"const": "accepted"}},
                "required": ["status"]
              }
            },
            "required": ["production"]
          },
          "then": {
            "properties": {
              "staging": {
                "properties": {"status": {"const": "accepted"}},
                "required": ["status"]
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pinned_file"}
    }
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pinned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected"]},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "integration": {"$ref": "#/$defs/pinned_file"},
            "backup": {"$ref": "#/$defs/pinned_file"},
            "restore": {"$ref": "#/$defs/pinned_file"},
            "monitoring": {"$ref": "#/$defs/pinned_file"},
            "rollback": {"$ref": "#/$defs/pinned_file"},
            "approval": {"$ref": "#/$defs/pinned_file"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "accepted"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {
                "required": ["integration", "backup", "restore", "monitoring", "rollback"]
              }
            }
          }
        }
      ]
    },
    "production_gate": {
      "allOf": [
        {"$ref": "#/$defs/environment_gate"},
        {
          "if": {
            "properties": {"status": {"const": "accepted"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {"required": ["approval"]}
            }
          }
        }
      ]
    }
  }
}
