    "CRAWLER_EXECUTION_ENABLED",
    "CRAWLER_EXTERNAL_CONTACT_ENABLED",
    "CRAWLER_ODOO_DELIVERY_ENABLED",
    "EMAIL_DELIVERY_ENABLED",
    "ENABLE_AGENT_SYNC",
    "ENABLE_EXTERNAL_DELIVERY",
