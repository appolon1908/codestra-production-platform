#!/usr/bin/python3
"""Emit a fixed, sanitized, read-only inventory of running Docker workloads."""

from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
from typing import Any


DOCKER = "/usr/bin/docker"
SHA256_RE = re.compile(r"^sha256:[0-9a-f]{64}$")
GIT_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
SOURCE_RE = re.compile(
    r"^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\.git)?$"
)
APPROVED_METADATA_LABELS = {
    "org.opencontainers.image.revision": "git_sha",
    "org.opencontainers.image.version": "version",
    "org.opencontainers.image.source": "source",
    "com.codestra.release.id": "release_id",
}
SAFETY_FLAGS = (
    "ALLOW_CAMPAIGN_ACTIVATION",
    "ALLOW_LIVE_CALLS",
    "ALLOW_LIVE_EMAIL",
    "ALLOW_LIVE_SMS",
    "CALLBACK_DELIVERY_ENABLED",
    "CALLBACK_EMAIL_COMMAND_ENABLED",
    "CALLBACK_DISPATCH",
