# Copy to /etc/codestra/server-a-certification/governance.env (0600 root:root).
CODESTRA_GOVERNANCE_REPOSITORY=appolon1908-hue/REPLACE_WITH_AUTHORITATIVE_REPOSITORY
CODESTRA_GOVERNANCE_SHA_FILE=/var/lib/codestra/governance/deployed.sha
CODESTRA_GOVERNANCE_STATE_FILE=/var/lib/codestra/governance/financial-governance-state.json
CODESTRA_GOVERNANCE_TOKEN_FILE=/etc/codestra/server-a-certification/github-status.token
CODESTRA_GOVERNANCE_CONTEXT=codestra/financial-governance
CODESTRA_GOVERNANCE_MAX_ATTEMPTS=4
CODESTRA_GOVERNANCE_METRICS_FILE=/var/lib/node_exporter/textfile_collector/codestra_financial_governance.prom
CODESTRA_GOVERNANCE_EVIDENCE_FILE=/opt/codestra/evidence/server-a-certification/governance/LAST_RESULT.json
