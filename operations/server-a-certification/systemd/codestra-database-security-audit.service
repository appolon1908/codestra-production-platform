[Unit]
Description=Audit Codestra PostgreSQL runtime roles and database CONNECT isolation
Wants=docker.service
After=docker.service
ConditionPathExists=/etc/codestra/server-a-certification/database-security.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/codestra/production-controls/current/operations/server-a-certification/audit-database-security.py
TimeoutStartSec=10m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/codestra/evidence/server-a-certification /var/lib/node_exporter/textfile_collector
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
