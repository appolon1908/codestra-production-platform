[Unit]
Description=Codestra Centrifugo internal, routed HTTPS, and WebSocket probe
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/codestra/server-a-certification/centrifugo-probe.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/codestra/production-controls/current/operations/server-a-certification/centrifugo-probe.py
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/codestra/evidence/server-a-certification /var/lib/node_exporter/textfile_collector
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
