[Unit]
Description=Publish and read back the Codestra financial governance commit status
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/codestra/server-a-certification/governance.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/codestra/server-a-certification/governance.env
ExecStart=/usr/bin/python3 /opt/codestra/production-controls/current/operations/server-a-certification/publish-governance-status.py
TimeoutStartSec=3m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/codestra/evidence/server-a-certification /var/lib/node_exporter/textfile_collector
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
