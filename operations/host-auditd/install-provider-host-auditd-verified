#!/bin/bash
set -euo pipefail

canonical_launcher=/usr/local/sbin/install-provider-host-auditd-verified
canonical_installer=/usr/local/libexec/codestra-host-auditd/install-provider-host-auditd.py
test "$(/usr/bin/readlink -f "$0")" = "$canonical_launcher"
test "$(/usr/bin/stat -c '%u:%g:%a' "$canonical_launcher")" = "0:0:755"
test "$(/usr/bin/stat -c '%u:%g:%a' "$canonical_installer")" = "0:0:755"

python_alias=/usr/bin/python3
python_target=$(/usr/bin/readlink -f "$python_alias")
python_name=${python_target##*/python}
stdlib=/usr/lib/python${python_name}

test -x "$python_alias"
test -d "$stdlib"
for authority in /usr /usr/lib "$stdlib"; do
  test "$(/usr/bin/stat -c '%u:%g:%a' "$authority")" = "0:0:755"
done
test -z "$(/usr/bin/find "$stdlib" -xdev \( ! -user root -o -perm /022 \) -print -quit)"

export CODESTRA_HOST_AUDITD_BOOTSTRAP_VERIFIED=stdlib-root-owned-read-only-v1
exec "$python_alias" -I -S "$canonical_installer" "$@"
