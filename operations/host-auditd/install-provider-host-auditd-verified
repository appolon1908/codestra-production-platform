#!/bin/bash
set -euo pipefail

canonical_launcher=/usr/local/sbin/install-provider-host-auditd-verified
canonical_installer=/usr/local/libexec/codestra-host-auditd/install-provider-host-auditd.py
test "$(/usr/bin/readlink -f "$0")" = "$canonical_launcher"
test "$(/usr/bin/stat -c '%u:%g:%a' "$canonical_launcher")" = "0:0:755"
test "$(/usr/bin/stat -c '%u:%g:%a' "$canonical_installer")" = "0:0:755"

python_image=/usr/local/libexec/codestra-host-auditd/python3
python_digest=/usr/local/libexec/codestra-host-auditd/python3.sha256
runtime_path=/usr/local/libexec/codestra-host-auditd/python3.stdlib
test "$([ -L "$python_image" ]; echo $?)" = 1
test "$([ -L "$python_digest" ]; echo $?)" = 1
test "$([ -L "$runtime_path" ]; echo $?)" = 1
test "$(/usr/bin/stat -c '%u:%g:%a' "$python_image")" = "0:0:755"
test "$(/usr/bin/stat -c '%u:%g:%a' "$python_digest")" = "0:0:600"
test "$(/usr/bin/stat -c '%u:%g:%a' "$runtime_path")" = "0:0:600"
for immutable in "$canonical_launcher" "$canonical_installer" "$python_image" "$python_digest" "$runtime_path"; do
  /usr/bin/lsattr -d "$immutable" | /usr/bin/awk '{ exit(index($1,"i") ? 0 : 1) }'
done
test "$(/usr/bin/getfacl -cp "$canonical_launcher")" = $'user::rwx\ngroup::r-x\nother::r-x'
test "$(/usr/bin/getfacl -cp "$canonical_installer")" = $'user::rwx\ngroup::r-x\nother::r-x'
test "$(/usr/bin/getfacl -cp "$python_image")" = $'user::rwx\ngroup::r-x\nother::r-x'
test "$(/usr/bin/getfacl -cp "$python_digest")" = $'user::rw-\ngroup::---\nother::---'
expected_python_sha=$(/usr/bin/cut -d' ' -f1 "$python_digest")
test "${#expected_python_sha}" -eq 64
test "$expected_python_sha" = "$(/usr/bin/sha256sum "$python_image" | /usr/bin/cut -d' ' -f1)"

stdlib=$(/usr/bin/cat "$runtime_path")
test "$stdlib" = "$(/usr/bin/readlink -f "$stdlib")"
[[ "$stdlib" =~ ^/usr/lib/python3\.[0-9]+$ ]]

test -x "$python_image"
test -d "$stdlib"
for authority in /usr /usr/lib "$stdlib"; do
  test "$(/usr/bin/stat -c '%u:%g:%a' "$authority")" = "0:0:755"
done
test -z "$(/usr/bin/find "$stdlib" -xdev \( ! -user root -o -perm /022 \) -print -quit)"
! /usr/bin/getfacl -Rcp "$stdlib" | /usr/bin/awk -F: '
  /^(user|group):[^:]+:/ && $3 ~ /w/ { found=1 }
  /^default:(user|group):[^:]+:/ && $4 ~ /w/ { found=1 }
  END { exit(found ? 0 : 1) }
'

export CODESTRA_HOST_AUDITD_BOOTSTRAP_VERIFIED=stdlib-root-owned-read-only-v1
exec "$python_image" -I -S "$canonical_installer" "$@"
