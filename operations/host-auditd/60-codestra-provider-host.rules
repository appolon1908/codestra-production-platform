## Additive Codestra provider-host rules. Never flush or lock unrelated rules.
-w /etc/ssh -p wa -k codestra_ssh_authority
-w /etc/sudoers -p wa -k codestra_sudo_authority
-w /etc/sudoers.d -p wa -k codestra_sudo_authority
-w /etc/audit -p wa -k codestra_audit_authority
-w /home/codestra-admin -p wa -k codestra_operator_key
-w /usr/local -p wa -k codestra_operator_code
-w /opt/codestra -p wa -k codestra_operator_state
-w /var/lib/codestra -p wa -k codestra_operator_state
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F auid=0 -k codestra_root_session_exec
-a always,exit -F arch=b32 -S execve,execveat -F euid=0 -F auid=0 -k codestra_root_session_exec
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -k codestra_privileged_exec
-a always,exit -F arch=b32 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -k codestra_privileged_exec
