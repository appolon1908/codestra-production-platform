#!/bin/bash
set -euo pipefail

# One-time root bootstrap after the release bundle and signature have been
# independently verified. This command is deliberately not a sudo target for
# codestra-admin; it establishes the immutable routine privilege boundary.
test "$EUID" -eq 0
source_dir=$(/usr/bin/readlink -f "$(/usr/bin/dirname "$0")")
launcher="$source_dir/install-provider-host-auditd-verified"
installer="$source_dir/install-provider-host-auditd.py"
test -f "$launcher" -a ! -L "$launcher"
test -f "$installer" -a ! -L "$installer"
/usr/bin/install -d -o root -g root -m 0755 /usr/local/libexec/codestra-host-auditd
/usr/bin/install -o root -g root -m 0755 "$installer" \
  /usr/local/libexec/codestra-host-auditd/install-provider-host-auditd.py
/usr/bin/install -o root -g root -m 0755 "$launcher" \
  /usr/local/sbin/install-provider-host-auditd-verified
/usr/bin/sync -f /usr/local/libexec/codestra-host-auditd/install-provider-host-auditd.py
/usr/bin/sync -f /usr/local/sbin/install-provider-host-auditd-verified
echo CODESTRA_HOST_AUDITD_LAUNCHER_BOOTSTRAP=PASS
