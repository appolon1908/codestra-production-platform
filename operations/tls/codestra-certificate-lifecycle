#!/usr/bin/env bash
set -euo pipefail
manifest=${CERTIFICATE_MANIFEST:-/etc/codestra/tls/certificates.tsv}
mapfile -t certificate_records <"$manifest"
for record in "${certificate_records[@]}"; do
  IFS='|' read -r name kind _ <<<"$record"
  case "$name" in ''|'#'*) continue ;; esac
  [ "$kind" = monitor ] && continue
  CERTIFICATE_MANIFEST="$manifest" /usr/local/sbin/renew-private-certificate "$name"
done
expiry_status=0
CERTIFICATE_MANIFEST="$manifest" /usr/local/sbin/check-certificate-expiry || expiry_status=$?
if ((expiry_status > 0)); then
  logger -p daemon.warning -t certificate-lifecycle -- "certificate expiry threshold active status=$expiry_status; Prometheus metrics published"
fi
/usr/local/sbin/check-public-tls api.codestra.co auth.codestra.co crm.codestra.agency n8n.codestra.agency n8n-staging.codestra.agency bridge-staging.codestra.agency phone.codestra.agency monitoring.codestra.co
