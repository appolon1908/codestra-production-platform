# Canonical public API boundary. Install as the complete api.codestra.co site
# block through the protected host-Caddy procedure; validate before reload.
api.codestra.co {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	@realtime path /ws/agent /api/v1/realtime/sessions /healthz /readyz
	handle @realtime {
		reverse_proxy codestra-websocket-gateway-gateway-1:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		reverse_proxy kong-gateway:8000 {
			header_up X-Real-IP {remote_host}
		}
	}
	log {
		output file /var/log/caddy/api-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Authorization delete
			request>uri query {
				delete apikey
			}
		}
	}
}
