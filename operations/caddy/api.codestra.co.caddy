# Canonical public API boundary. Install as the complete api.codestra.co site
# block through the protected host-Caddy procedure; validate before reload.
api.codestra.co {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	# The public listener rejects the complete private namespace before the
	# catch-all proxy. The inline deny matcher is intentionally not an exposed
	# endpoint and therefore must not be registered as a public API route.
	handle /internal* {
		respond 404
	}
	# The realtime gateway owns only WebSocket transport and its own read-only
	# health/version endpoints. Realtime ticket creation remains a POST owned by
	# Middleware and therefore falls through to the canonical API backend below.
	@realtime path /ws/agent /healthz /readyz /version
	handle @realtime {
		reverse_proxy 127.0.0.1:18102 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:18101 {
			header_up X-Real-IP {remote_host}
		}
	}
	log {
		output file /var/log/caddy/api-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Authorization delete
			request>uri query {
				delete apikey
			}
		}
	}
}
