# Canonical public API boundary. Install as the complete api.codestra.co site
# block through the protected host-Caddy procedure; validate before reload.
api.codestra.co {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	# Only the upgrade stays on the low-latency direct listener. Session
	# creation, health and version requests traverse Kong below.
	@realtime path /ws/agent
	handle @realtime {
		reverse_proxy 127.0.0.1:18102 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:18101 {
			header_up X-Real-IP {remote_host}
		}
	}
	log {
		output file /var/log/caddy/api-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Authorization delete
			request>uri query {
				delete apikey
			}
		}
	}
}
