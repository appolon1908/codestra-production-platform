CODESTRA_BACKUP_ROOT=/opt/codestra/backups/scheduled
CODESTRA_BACKUP_GPG_RECIPIENT=REPLACE_WITH_APPROVED_RECIPIENT_FINGERPRINT
CODESTRA_BACKUP_REMOTE_HOST=backup-user@approved-backup-host
CODESTRA_BACKUP_REMOTE_DIR=/approved/codestra
CODESTRA_BACKUP_SSH_IDENTITY=/etc/codestra/backup/replication-key
CODESTRA_BACKUP_KNOWN_HOSTS=/etc/codestra/backup/known_hosts
CODESTRA_BACKUP_ALERT_URL=
CODESTRA_BACKUP_MAX_AGE_SECONDS=93600
CODESTRA_BACKUP_MIN_FREE_BYTES=10737418240
CODESTRA_BACKUP_RETENTION_DAYS=35
CODESTRA_BACKUP_MIN_VALID=2
