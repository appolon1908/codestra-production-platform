# Copy to /etc/codestra/server-a-certification/database-backup.env (0600 root:root).
# Values are references only. Never commit credentials or private keys.
CODESTRA_DATABASE_BACKUP_ROOT=/opt/codestra/backups/database-certification
CODESTRA_DATABASE_BACKUP_GPG_HOME=/etc/codestra/backup-gpg
CODESTRA_DATABASE_BACKUP_GPG_RECIPIENT=REPLACE_WITH_APPROVED_40_TO_64_HEX_RECIPIENT_FINGERPRINT
CODESTRA_DATABASE_BACKUP_GPG_SIGNING_KEY=REPLACE_WITH_OFFLINE_APPROVED_SIGNING_FINGERPRINT
CODESTRA_DATABASE_BACKUP_REMOTE=backup-operator@REPLACE_WITH_OFFHOST:/srv/codestra/server-a
CODESTRA_DATABASE_BACKUP_SSH_IDENTITY=/etc/codestra/server-a-certification/offhost-backup.key
CODESTRA_DATABASE_BACKUP_KNOWN_HOSTS=/etc/codestra/server-a-certification/offhost-known-hosts
CODESTRA_PROTECTED_PATHS_FILE=/etc/codestra/server-a-certification/protected-paths.txt
CODESTRA_BACKUP_IMMUTABILITY_EVIDENCE_FILE=/etc/codestra/server-a-certification/immutable-retention.json
CODESTRA_DATABASE_BACKUP_MINIMUM_FREE_PERCENT=20
CODESTRA_BACKUP_QUIESCE_SERVICES=YES
CODESTRA_DATABASE_BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/codestra_database_backup.prom
