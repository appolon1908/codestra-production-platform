# Copy to /etc/codestra/server-a-certification/database-restore.env (0600 root:root).
# The restore always downloads the advertised stamp from the off-host copy.
CODESTRA_DATABASE_RESTORE_REMOTE=backup-operator@REPLACE_WITH_OFFHOST:/srv/codestra/server-a
CODESTRA_DATABASE_RESTORE_STAMP_FILE=/opt/codestra/backups/database-certification/LAST_SUCCESS
CODESTRA_DATABASE_RESTORE_SSH_IDENTITY=/etc/codestra/server-a-certification/offhost-backup.key
CODESTRA_DATABASE_RESTORE_KNOWN_HOSTS=/etc/codestra/server-a-certification/offhost-known-hosts
CODESTRA_DATABASE_RESTORE_GPG_HOME=/etc/codestra/backup-gpg
CODESTRA_DATABASE_RESTORE_GPG_SIGNING_FINGERPRINT=REPLACE_WITH_APPROVED_SIGNING_FINGERPRINT
CODESTRA_DATABASE_RESTORE_ROOT=/opt/codestra/evidence/database-restore
CODESTRA_POSTGRES_RESTORE_IMAGE=postgres@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
CODESTRA_KEYCLOAK_RESTORE_IMAGE=quay.io/keycloak/keycloak@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
CODESTRA_N8N_RESTORE_IMAGE=docker.n8n.io/n8nio/n8n@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
CODESTRA_N8N_RECOVERY_ENCRYPTION_KEY_FILE=/etc/codestra/runtime-secrets/n8n/encryption-key
CODESTRA_N8N_MINIMUM_CREDENTIAL_COUNT=1
CODESTRA_RESTORE_PYTHON_IMAGE=python@sha256:6d43704baacd1bfbe7c295d7f13079d5d8104ed33568873133f8fc69980419df
CODESTRA_DATABASE_RESTORE_METRICS_FILE=/var/lib/node_exporter/textfile_collector/codestra_database_restore.prom
