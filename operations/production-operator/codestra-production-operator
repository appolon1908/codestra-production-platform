class OperatorError(RuntimeError):
    pass


def checked_root_bytes(path: Path, *, expected_mode: int = 0o600) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise OperatorError(f"unsafe file type: {path}") from error
        raise OperatorError(f"required root file unavailable: {path}") from error
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise OperatorError(f"unsafe file type: {path}")
        if info.st_uid != 0 or info.st_gid != 0:
            raise OperatorError(f"unsafe ownership: {path}")
        if stat.S_IMODE(info.st_mode) != expected_mode:
            raise OperatorError(f"unsafe mode: {path}")
        return stream.read()


def checked_root_file(path: Path, *, expected_mode: int = 0o600) -> str:
    try:
        return checked_root_bytes(path, expected_mode=expected_mode).decode("ascii").strip()
    except UnicodeError as error:
        raise OperatorError(f"required root file unreadable: {path}") from error


