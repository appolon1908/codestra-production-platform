def hash_operator_file(path: Path, *, expected_mode: int = 0o600) -> tuple[str, int]:
    """Hash a protected file incrementally without buffering it in memory."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise OperatorError(f"operator stream unavailable: {path}") from error
    digest = hashlib.sha256()
    size = 0
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.geteuid()
            or info.st_gid != os.getegid()
            or stat.S_IMODE(info.st_mode) != expected_mode
        ):
            raise OperatorError(f"operator stream metadata unsafe: {path}")
        while True:
            chunk = stream.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            size += len(chunk)
    return digest.hexdigest(), size


def stream_command_to_atomic_file(
    command: list[str],
    path: Path,
    *,
    timeout: int = 1800,
    mode: int = 0o600,
) -> tuple[str, int]:
    """Stream command stdout to an atomic protected file and hash it incrementally."""
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        mode,
    )
    try:
        with tempfile.TemporaryFile() as errors:
            with os.fdopen(descriptor, "wb") as stream:
                os.fchmod(stream.fileno(), mode)
                completed = subprocess.run(
                    command,
                    check=False,
                    stdin=subprocess.DEVNULL,
                    stdout=stream,
                    stderr=errors,
                    timeout=timeout,
                    env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"},
                )
                stream.flush()
                os.fsync(stream.fileno())
            if completed.returncode != 0:
                errors.seek(0, os.SEEK_END)
                error_size = errors.tell()
                errors.seek(max(0, error_size - 4096))
                raise subprocess.CalledProcessError(
                    completed.returncode,
                    command,
                    stderr=errors.read(),
                )
        digest, size = hash_operator_file(temporary, expected_mode=mode)
        if size == 0:
            raise OperatorError("streamed command output is empty")
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)
    readback_digest, readback_size = hash_operator_file(path, expected_mode=mode)
    if not hmac.compare_digest(readback_digest, digest) or readback_size != size:
        raise OperatorError(f"operator stream readback mismatch: {path}")
    return digest, size


def run_with_verified_file_stdin(
    command: list[str],
    path: Path,
    expected_digest: str,
    *,
    timeout: int = 1800,
) -> subprocess.CompletedProcess[bytes]:
    """Verify a protected file through one descriptor, then stream it to stdin."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise OperatorError(f"operator stream unavailable: {path}") from error
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.geteuid()
            or info.st_gid != os.getegid()
            or stat.S_IMODE(info.st_mode) != 0o600
        ):
            raise OperatorError(f"operator stream metadata unsafe: {path}")
        digest = hashlib.sha256()
        size = 0
        while True:
            chunk = stream.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            size += len(chunk)
        if (
            size == 0
            or re.fullmatch(r"[0-9a-f]{64}", expected_digest) is None
            or not hmac.compare_digest(digest.hexdigest(), expected_digest)
        ):
            raise OperatorError("operator input stream checksum mismatch")
        stream.seek(0)
        return subprocess.run(
            command,
            stdin=stream,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"},
        )


def docker_inspect(name: str) -> dict[str, object]:
    result = run_bytes(["/usr/bin/docker", "inspect", name], timeout=30)
    return json.loads(result.stdout)[0]


def standby_configuration_matches(current: dict[str, object], subject: str) -> bool:
    config = current["Config"]
    host = current["HostConfig"]
    return bool(
        config["Image"] == subject
        and config.get("Entrypoint") == STANDBY_ENTRYPOINT
        and config.get("Cmd") == STANDBY_COMMAND
        and host["NetworkMode"] == "none"
        and host.get("ReadonlyRootfs") is True
        and host.get("CapDrop") == ["ALL"]
        and "no-new-privileges" in host.get("SecurityOpt", [])
    )


def stage_standby(config: dict[str, str]) -> dict[str, object]:
    credential = sys.stdin.buffer.read(16384)
    if not credential or len(credential) >= 16384 or any(item in credential for item in (b"\x00", b"\n", b"\r")):
        raise OperatorError("invalid GHCR credential input")
    subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    docker_config = Path(tempfile.mkdtemp(prefix="codestra-docker-", dir="/run"))
    try:
        run_bytes(["/usr/bin/docker", "--config", str(docker_config), "login", "ghcr.io", "--username", "appolon1908-hue", "--password-stdin"], stdin=credential, timeout=60)
        credential = b""
        run_bytes(["/usr/bin/docker", "--config", str(docker_config), "pull", "--quiet", subject])
        image = json.loads(run_bytes(["/usr/bin/docker", "image", "inspect", subject], timeout=60).stdout)[0]
        if subject not in image.get("RepoDigests", []):
            raise OperatorError("pulled image digest mismatch")
    finally:
        credential = b""
        shutil.rmtree(docker_config, ignore_errors=True)
    create_standby = False
    try:
        existing = docker_inspect(STANDBY_CONTAINER)
        if existing["Config"]["Image"] != subject:
            raise OperatorError("standby exists with a different digest")
        if standby_configuration_matches(existing, subject):
            run_bytes(["/usr/bin/docker", "start", STANDBY_CONTAINER], timeout=60)
        else:
            if existing["State"].get("Running"):
                run_bytes(["/usr/bin/docker", "stop", "--time", "20", STANDBY_CONTAINER], timeout=60)
            run_bytes(["/usr/bin/docker", "rm", STANDBY_CONTAINER], timeout=60)
            create_standby = True
    except subprocess.CalledProcessError:
        create_standby = True
    if create_standby:
        run_bytes([
            "/usr/bin/docker", "create", "--name", STANDBY_CONTAINER,
            "--network", "none", "--read-only", "--cap-drop", "ALL",
            "--security-opt", "no-new-privileges", "--tmpfs", "/tmp:rw,noexec,nosuid,size=16m",
            "--entrypoint", STANDBY_ENTRYPOINT[0],
            "--env", "PSTN_DIALING=DISABLED", "--env", "PRODUCTION_DIALING=DISABLED",
            "--env", "SEND_EVENTS=false", "--env", "ENABLE_EXTERNAL_DELIVERY=false",
            "--env", "LIVE_WRITE=false", "--env", "ODOO_WRITE=false",
            "--env", "N8N_DELIVERY_ENABLED=false", subject, *STANDBY_COMMAND,
        ], timeout=120)
        run_bytes(["/usr/bin/docker", "start", STANDBY_CONTAINER], timeout=60)
    current = docker_inspect(STANDBY_CONTAINER)
    if not standby_configuration_matches(current, subject):
        raise OperatorError("standby isolation read-back failed")
    time.sleep(5)
    if not docker_inspect(STANDBY_CONTAINER)["State"]["Running"]:
        raise OperatorError("standby exited during startup")
    return {"subject": subject, "network_mode": "none"}


def certify_standby(config: dict[str, str]) -> dict[str, object]:
    current = docker_inspect(STANDBY_CONTAINER)
    subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    if not standby_configuration_matches(current, subject) or not current["State"]["Running"]:
        raise OperatorError("standby certification mismatch")
    return {"subject": subject, "network_mode": "none"}


def remove_standby(config: dict[str, str]) -> dict[str, object]:
    try:
        current = docker_inspect(STANDBY_CONTAINER)
    except subprocess.CalledProcessError:
        return {"candidate_present": False}
    subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    if current["Config"]["Image"] != subject:
        raise OperatorError("standby is outside the installed release tuple")
    run_bytes(["/usr/bin/docker", "stop", "--time", "20", STANDBY_CONTAINER], timeout=60)
    run_bytes(["/usr/bin/docker", "rm", STANDBY_CONTAINER], timeout=60)
    return {"candidate_present": False}


def control_plane_paths(config: dict[str, str]) -> tuple[Path, Path]:
    sha = config["protected_sha"]
    archive = CONTROL_PLANE_ARCHIVE_ROOT / f"codestra-production-platform-{sha}.tar.gz"
    release = CONTROL_PLANE_RELEASE_ROOT / sha
    return archive, release


def validate_control_plane_archive(archive: Path, protected_sha: str) -> None:
    """Reject links, devices, traversal, and unexpected archive roots."""
    if not re.fullmatch(r"[0-9a-f]{40}", protected_sha):
        raise OperatorError("protected SHA is malformed")
    expected_root = "codestra"
    try:
        with tarfile.open(archive, mode="r:gz") as bundle:
            members = bundle.getmembers()
            if not members:
                raise OperatorError("control-plane archive is empty")
            for member in members:
                parts = Path(member.name).parts
                if (
                    not parts
                    or parts[0] != expected_root
                    or member.name.startswith("/")
                    or ".." in parts
                    or member.issym()
                    or member.islnk()
                    or member.isdev()
                    or member.isfifo()
                ):
                    raise OperatorError("control-plane archive member rejected")
    except (tarfile.TarError, OSError) as error:
        raise OperatorError("control-plane archive validation failed") from error


def copy_pinned_control_plane_archive(source: Path, target: Path, expected: str) -> None:
    """Copy once from the bootstrap account into a root-only immutable path."""
    try:
        descriptor = os.open(source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise OperatorError("control-plane archive unavailable or unsafe") from error
    digest = hashlib.sha256()
    with os.fdopen(descriptor, "rb") as incoming:
        info = os.fstat(incoming.fileno())
        bootstrap_uid = pwd.getpwnam("codestra-admin").pw_uid
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != bootstrap_uid
            or stat.S_IMODE(info.st_mode) != 0o600
        ):
            raise OperatorError("control-plane archive ownership or mode is unsafe")
        output_descriptor = os.open(
            target,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        with os.fdopen(output_descriptor, "wb") as outgoing:
            while chunk := incoming.read(1024 * 1024):
                digest.update(chunk)
                outgoing.write(chunk)
            outgoing.flush()
            os.fsync(outgoing.fileno())
    if digest.hexdigest() != expected:
        target.unlink(missing_ok=True)
        raise OperatorError("control-plane archive checksum mismatch")


def prepare_control_plane_release(
    trusted_archive: Path, release: Path, protected_sha: str, expected: str
) -> None:
    """Publish a complete extracted tree atomically and permit exact retries."""
    marker = release / ".protected-archive.sha256"
    if release.exists() or release.is_symlink():
        if release.is_symlink() or not release.is_dir():
            raise OperatorError("control-plane release path is unsafe")
        if checked_root_file(marker, expected_mode=0o644) != expected:
            raise OperatorError("existing control-plane release is not the approved archive")
        return
    release.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    candidate = Path(tempfile.mkdtemp(prefix=f".{protected_sha}.", dir=release.parent))
    try:
        os.chmod(candidate, 0o755)
        run_bytes([
            "/usr/bin/tar", "--extract", "--gzip", "--file", str(trusted_archive),
            "--directory", str(candidate), "--strip-components=1",
            "--no-same-owner", "--no-same-permissions",
        ])
        marker_path = candidate / marker.name
        marker_path.write_text(expected + "\n", encoding="ascii")
        marker_path.chmod(0o644)
        candidate.rename(release)
    except Exception:
        shutil.rmtree(candidate, ignore_errors=True)
        raise


def validate_control_plane(config: dict[str, str]) -> dict[str, object]:
    _, release = control_plane_paths(config)
    expected = {
        "core.py": hashlib.sha256((release / "control_plane_service/core.py").read_bytes()).hexdigest(),
        "email_adapters.py": hashlib.sha256((release / "control_plane_service/email_adapters.py").read_bytes()).hexdigest(),
        "postal_inbound.py": hashlib.sha256((release / "control_plane_service/postal_inbound.py").read_bytes()).hexdigest(),
    }
    for name, digest_value in expected.items():
        result = run_bytes(["/usr/bin/docker", "exec", CONTROL_PLANE_API, "sha256sum", f"/app/control_plane_service/{name}"], timeout=30)
        if result.stdout.decode().split()[0] != digest_value:
            raise OperatorError(f"control-plane source readback mismatch: {name}")
    health = docker_inspect(CONTROL_PLANE_API)
    if health["State"].get("Health", {}).get("Status") != "healthy":
        raise OperatorError("control-plane API is not healthy")
    worker = docker_inspect(CONTROL_PLANE_WORKER)
    if worker["State"].get("Health", {}).get("Status") != "healthy":
        raise OperatorError("control-plane worker is not healthy")
    api_env = dict(
        item.split("=", 1)
        for item in health["Config"]["Env"]
        if "=" in item
    )
    if api_env.get("SOURCE_SHA") != config["protected_sha"]:
        raise OperatorError("control-plane source SHA environment readback mismatch")
    if api_env.get("RELEASE_ID") != config["protected_sha"]:
        raise OperatorError("control-plane release ID environment readback mismatch")
    version_response = run_bytes([
        "/usr/bin/docker", "exec", CONTROL_PLANE_API, "python", "-c",
        (
            "import urllib.request;"
            "print(urllib.request.urlopen("
            "'http://127.0.0.1:8096/version',timeout=3).read().decode())"
        ),
    ], timeout=30)
    version = json.loads(version_response.stdout)
    if (
        version.get("source_sha") != config["protected_sha"]
        or version.get("release_id") != config["protected_sha"]
    ):
        raise OperatorError("control-plane version endpoint readback mismatch")
    query = (
        "select count(*) from information_schema.tables where "
        "table_schema='control_plane' and table_name in "
        "('campaign_email_domain','agent_mailbox','mailbox_provisioning_event')"
    )
    tables = run_bytes(["/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "psql", "-U", "postgres", "-d", CONTROL_PLANE_DB, "-Atc", query], timeout=30)
    if tables.stdout.decode().strip() != "3":
        raise OperatorError("mailbox runtime schema readback failed")
    env = docker_inspect(CONTROL_PLANE_WORKER)["Config"]["Env"]
    flags = dict(item.split("=", 1) for item in env if "=" in item)
    required_flags = {
        "KLYROW_MODE": "test",
        "TELNEXA_MODE": "simulator",
        "LIVE_SMS_DELIVERY": "false",
        "LIVE_EMAIL_DELIVERY": "false",
        "LIVE_PSTN_DIALING": "false",
    }
    if any(flags.get(name) != value for name, value in required_flags.items()):
        raise OperatorError("control-plane external delivery is not fail-closed")
    return {"protected_source_readback": "PASS", "mailbox_runtime_tables": 3,
            "control_plane_worker": "PASS",
            "postal_inbound_adapter": "PASS", "external_delivery": "DISABLED"}


def wait_control_plane_health(timeout_seconds: int = 120) -> None:
    """Wait for Docker's scheduled health probe without accepting unhealthy state."""
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        health = docker_inspect(CONTROL_PLANE_API)["State"].get("Health", {}).get("Status")
        if health == "healthy":
            return
        if health == "unhealthy":
            raise OperatorError("control-plane API became unhealthy")
        time.sleep(2)
    raise OperatorError("control-plane API health check timed out")


def stage_control_plane(config: dict[str, str]) -> dict[str, object]:
    archive, release = control_plane_paths(config)
    expected = checked_root_file(CONTROL_PLANE_ARCHIVE_CHECKSUM, expected_mode=0o644)
    if re.fullmatch(r"[0-9a-f]{64}", expected) is None:
        raise OperatorError("control-plane archive checksum is malformed")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = CONTROL_PLANE_BACKUP_ROOT / stamp
    backup.mkdir(mode=0o700, parents=True)
    trusted_archive = backup / "protected-release.tar.gz"
    copy_pinned_control_plane_archive(archive, trusted_archive, expected)
    validate_control_plane_archive(trusted_archive, config["protected_sha"])
    for container, label in ((CONTROL_PLANE_API, "api"), (CONTROL_PLANE_WORKER, "worker")):
        image_id = str(docker_inspect(container)["Image"])
        image_record = backup / f"{label}-image-id"
        image_record.write_text(image_id + "\n", encoding="ascii")
        image_record.chmod(0o600)
        run_bytes(["/usr/bin/docker", "tag", image_id, f"codestra/{CONTROL_PLANE_PROJECT}-{label}:rollback-{stamp}"], timeout=60)
    database_owner = run_bytes([
        "/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "psql", "-U", "postgres",
        "-d", "postgres", "-Atc",
        f"select pg_get_userbyid(datdba) from pg_database where datname='{CONTROL_PLANE_DB}'",
    ], timeout=30).stdout.decode().strip()
    if re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", database_owner) is None:
        raise OperatorError("control-plane database owner readback failed")
    owner_record = backup / "database-owner"
    owner_record.write_text(database_owner + "\n", encoding="ascii")
    owner_record.chmod(0o600)
    with (backup / "control-plane.sql").open("wb") as dump:
        result = run_bytes(["/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "pg_dump", "-U", "postgres", "-d", CONTROL_PLANE_DB], timeout=1800)
        dump.write(result.stdout)
    (backup / "control-plane.sql").chmod(0o600)
    dump_checksum = backup / "control-plane.sql.sha256"
    dump_checksum.write_text(
        hashlib.sha256((backup / "control-plane.sql").read_bytes()).hexdigest() + "\n",
        encoding="ascii",
    )
    dump_checksum.chmod(0o600)
    rollback_marker = CONTROL_PLANE_BACKUP_ROOT / "LAST_SUCCESS"
    rollback_marker.write_text(stamp + "\n", encoding="ascii")
    rollback_marker.chmod(0o600)
    prepare_control_plane_release(trusted_archive, release, config["protected_sha"], expected)
    compose = ["/usr/bin/docker", "compose", "--project-name", CONTROL_PLANE_PROJECT,
               "--file", str(release / "deploy/control-plane/compose.yaml"),
               "--file", str(release / "deploy/control-plane/compose.live-delivery-safety.yaml")]
    try:
        for migration in sorted((release / "migrations/control_plane").glob("*.sql")):
            run_bytes(["/usr/bin/docker", "exec", "-i", CONTROL_PLANE_DB_CONTAINER, "psql", "-v", "ON_ERROR_STOP=1", "-U", "postgres", "-d", CONTROL_PLANE_DB], stdin=migration.read_bytes(), timeout=300)
        run_bytes([
            *compose, "build", "--pull=false",
            "--build-arg", f"VCS_REF={config['protected_sha']}",
            "--build-arg", f"BUILD_CREATED={stamp}",
        ], timeout=1800)
        run_bytes([*compose, "up", "--detach", "--remove-orphans"], timeout=300)
        wait_control_plane_health()
        result = validate_control_plane(config)
    except Exception:
        rollback_control_plane(config)
        raise
    return {"backup_stamp": stamp, **result}


def rollback_control_plane(config: dict[str, str]) -> dict[str, object]:
    rollback = validate_control_plane_rollback()
    stamp = rollback["rollback_stamp"]
    _, release = control_plane_paths(config)
    backup = CONTROL_PLANE_BACKUP_ROOT / stamp
    rollback_images = backup / "rollback-images.yaml"
    atomic_root_bytes(
        rollback_images,
        (
            "services:\n"
            f"  api:\n    image: codestra/{CONTROL_PLANE_PROJECT}-api:rollback-{stamp}\n"
            f"  worker:\n    image: codestra/{CONTROL_PLANE_PROJECT}-worker:rollback-{stamp}\n"
        ).encode("ascii"),
        mode=0o600,
    )
    compose = ["/usr/bin/docker", "compose", "--project-name", CONTROL_PLANE_PROJECT,
               "--file", str(release / "deploy/control-plane/compose.yaml"),
               "--file", str(release / "deploy/control-plane/compose.live-delivery-safety.yaml"),
               "--file", str(rollback_images)]
    run_bytes([*compose, "stop", "--timeout", "30"], timeout=120)
    database_owner = checked_root_file(backup / "database-owner", expected_mode=0o600)
    if re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", database_owner) is None:
        raise OperatorError("control-plane rollback database owner is malformed")
    database_dump = checked_root_bytes(backup / "control-plane.sql")
    run_bytes([
        "/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "psql", "-U", "postgres",
        "-d", "postgres", "-v", "ON_ERROR_STOP=1", "-c",
        f"select pg_terminate_backend(pid) from pg_stat_activity where datname='{CONTROL_PLANE_DB}' and pid<>pg_backend_pid()",
    ], timeout=30)
    run_bytes(["/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "dropdb", "-U", "postgres", "--if-exists", CONTROL_PLANE_DB], timeout=60)
    run_bytes(["/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "createdb", "-U", "postgres", "-O", database_owner, CONTROL_PLANE_DB], timeout=60)
    run_bytes(["/usr/bin/docker", "exec", "-i", CONTROL_PLANE_DB_CONTAINER, "psql", "-U", "postgres", "-d", CONTROL_PLANE_DB, "-v", "ON_ERROR_STOP=1"], stdin=database_dump, timeout=1800)
    run_bytes([*compose, "up", "--detach", "--no-build"], timeout=300)
    return {"rollback_stamp": stamp, "database_restored": "PASS", "external_delivery": "DISABLED"}


def validate_klyrow_email_authorization(config: dict[str, str]) -> dict[str, object]:
    """Validate the root-controlled, exact-release authorization and remote evidence summary."""
    try:
        payload = json.loads(checked_root_file(KLYROW_EMAIL_AUTHORIZATION))
    except json.JSONDecodeError as error:
        raise OperatorError("Klyrow email authorization is malformed") from error
    required = {
        "schema", "approved", "change_id", "protected_sha", "maintenance_date",
        "klyrow_backup", "klyrow_evidence_sha256", "verified_domains",
        "held_messages", "smtp_no_data", "owner",
    }
    if set(payload) != required or payload.get("schema") != "codestra.klyrow-email-authorization.v1":
        raise OperatorError("Klyrow email authorization schema mismatch")
    if payload.get("approved") is not True:
        raise OperatorError("Klyrow email delivery is not approved")
    for key in ("change_id", "protected_sha", "maintenance_date"):
        if payload.get(key) != config[key]:
            raise OperatorError(f"Klyrow email authorization {key} mismatch")
    if not re.fullmatch(r"/var/backups/codestra-operators/klyrow/[0-9]{8}T[0-9]{6}Z", str(payload.get("klyrow_backup"))):
        raise OperatorError("Klyrow backup evidence path rejected")
    if not re.fullmatch(r"[0-9a-f]{64}", str(payload.get("klyrow_evidence_sha256"))):
        raise OperatorError("Klyrow evidence digest rejected")
    if payload.get("verified_domains") != 14 or payload.get("held_messages") != 2:
        raise OperatorError("Klyrow domain or held-message evidence mismatch")
    if payload.get("smtp_no_data") != "PASS" or not isinstance(payload.get("owner"), str) or not payload["owner"]:
        raise OperatorError("Klyrow SMTP or owner approval evidence mismatch")
    return {
        "authorization": "PASS", "verified_domains": 14, "held_messages_preserved": 2,
        "smtp_no_data": "PASS", "klyrow_evidence_sha256": payload["klyrow_evidence_sha256"],
    }


