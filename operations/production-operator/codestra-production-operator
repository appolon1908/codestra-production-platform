    "/usr/bin/sudo -n /usr/sbin/asterisk -rx 'core show channels count'"
)
VICIDIAL_REGISTRATIONS_COMMAND = (
    "/usr/bin/sudo -n /usr/sbin/asterisk -rx 'pjsip show registrations'"
)


class OperatorError(RuntimeError):
    pass


def checked_root_file(path: Path, *, expected_mode: int = 0o600) -> str:
    try:
        info = path.lstat()
    except OSError as error:
        raise OperatorError(f"required root file unavailable: {path}") from error
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise OperatorError(f"unsafe file type: {path}")
    if info.st_uid != 0 or info.st_gid != 0:
        raise OperatorError(f"unsafe ownership: {path}")
    if stat.S_IMODE(info.st_mode) != expected_mode:
        raise OperatorError(f"unsafe mode: {path}")
    try:
        return path.read_text(encoding="ascii").strip()
    except (OSError, UnicodeError) as error:
        raise OperatorError(f"required root file unreadable: {path}") from error


OWNER_WINDOW_WAIVER_STATEMENTS = {
    "MAINTENANCE_WINDOW=WAIVED_BY_OWNER",
    "MAINTENANCE_WINDOW_WAIVER_APPROVED=YES",
    "MAINTENANCE_WINDOW_WAIVER_AUTHORITY=OWNER",
    "IMMEDIATE_PRODUCTION_MUTATION_AUTHORIZED=YES",
}


def validate_owner_window_waiver() -> dict[str, str]:
    """Validate the one fixed, root-controlled owner maintenance waiver."""
    if OWNER_WINDOW_WAIVER.parent != OWNER_WAIVER_DIR or OWNER_WINDOW_WAIVER_CHECKSUM.parent != OWNER_WAIVER_DIR:
        raise OperatorError("owner waiver path escaped approved evidence directory")
    waiver = checked_root_file(OWNER_WINDOW_WAIVER)
    checksum_record = checked_root_file(OWNER_WINDOW_WAIVER_CHECKSUM)
    match = re.fullmatch(
        r"([0-9a-f]{64})  OWNER-MAINTENANCE-WINDOW-WAIVER\.txt", checksum_record
    )
    if match is None:
        raise OperatorError("owner waiver checksum record is malformed")
    actual = hashlib.sha256((waiver + "\n").encode("ascii")).hexdigest()
    if actual != match.group(1):
        raise OperatorError("owner waiver checksum mismatch")
    statements = set(waiver.splitlines())
    if not OWNER_WINDOW_WAIVER_STATEMENTS <= statements:
        raise OperatorError("owner waiver authorization statements are incomplete")
    return {
        "maintenance_window": "WAIVED_BY_OWNER",
        "owner_window_waiver_evidence": "PASS",
        "window_check": "BYPASSED_BY_VALID_OWNER_WAIVER",
    }


def require_maintenance_window(now: dt.datetime | None = None) -> dict[str, str]:
    raw_date = checked_root_file(MAINTENANCE_DATE)
    if not DATE_RE.fullmatch(raw_date):
        raise OperatorError("maintenance date is malformed")
    approved_date = dt.date.fromisoformat(raw_date)
    current = now or dt.datetime.now(dt.timezone.utc)
    local = current.astimezone(ZoneInfo("America/New_York"))
    if local.date() == approved_date and 0 <= local.hour < 4:
        return {
            "maintenance_date": raw_date,
            "maintenance_window": "PASS",
            "owner_window_waiver_evidence": "NOT_REQUIRED",
            "window_check": "APPROVED_WINDOW",
        }
    result = validate_owner_window_waiver()
    return {"maintenance_date": raw_date, **result}


def load_release_config() -> dict[str, str]:
    raw = checked_root_file(RELEASE_CONFIG, expected_mode=0o644)
    try:
        config = json.loads(raw)
    except json.JSONDecodeError as error:
        raise OperatorError("release tuple is malformed") from error
    required = {"protected_sha", "image_digest", "change_id", "maintenance_date"}
    if set(config) != required:
        raise OperatorError("release tuple schema mismatch")
    patterns = {
        "protected_sha": r"[0-9a-f]{40}",
        "image_digest": r"sha256:[0-9a-f]{64}",
        "change_id": r"CHG-[0-9]{8}-CODESTRA-PRODUCTION-ACTIVATION-[0-9]{2}",
        "maintenance_date": r"20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])",
    }
    if any(not isinstance(config[key], str) or re.fullmatch(patterns[key], config[key]) is None for key in required):
        raise OperatorError("release tuple value rejected")
    return config


def run_fixed(command: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=1800,
        env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"},
    )


def validate_backup_state() -> dict[str, object]:
    info = BACKUP_STATE_VALIDATOR.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise OperatorError("backup-state validator has unsafe file type")
    if info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o755:
        raise OperatorError("backup-state validator has unsafe ownership or mode")
    invocation = run_fixed([str(BACKUP_STATE_VALIDATOR)])
    if invocation.returncode != 0:
        raise OperatorError("backup-state validation failed")
    return {"validator": str(BACKUP_STATE_VALIDATOR), "returncode": 0}


def run_bytes(command: list[str], *, stdin: bytes | None = None, timeout: int = 1800) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        command,
        input=stdin,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"},
    )


def docker_inspect(name: str) -> dict[str, object]:
    result = run_bytes(["/usr/bin/docker", "inspect", name], timeout=30)
    return json.loads(result.stdout)[0]


def stage_standby(config: dict[str, str]) -> dict[str, object]:
    credential = sys.stdin.buffer.read(16384)
    if not credential or len(credential) >= 16384 or any(item in credential for item in (b"\x00", b"\n", b"\r")):
        raise OperatorError("invalid GHCR credential input")
    subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    docker_config = Path(tempfile.mkdtemp(prefix="codestra-docker-", dir="/run"))
    try:
        run_bytes(["/usr/bin/docker", "--config", str(docker_config), "login", "ghcr.io", "--username", "appolon1908-hue", "--password-stdin"], stdin=credential, timeout=60)
        credential = b""
        run_bytes(["/usr/bin/docker", "--config", str(docker_config), "pull", "--quiet", subject])
        image = json.loads(run_bytes(["/usr/bin/docker", "image", "inspect", subject], timeout=60).stdout)[0]
        if subject not in image.get("RepoDigests", []):
            raise OperatorError("pulled image digest mismatch")
    finally:
        credential = b""
        shutil.rmtree(docker_config, ignore_errors=True)
    try:
        existing = docker_inspect(STANDBY_CONTAINER)
        if existing["Config"]["Image"] != subject:
            raise OperatorError("standby exists with a different digest")
        run_bytes(["/usr/bin/docker", "start", STANDBY_CONTAINER], timeout=60)
    except subprocess.CalledProcessError:
        run_bytes([
            "/usr/bin/docker", "create", "--name", STANDBY_CONTAINER,
            "--network", "none", "--read-only", "--cap-drop", "ALL",
            "--security-opt", "no-new-privileges", "--tmpfs", "/tmp:rw,noexec,nosuid,size=16m",
            "--env", "PSTN_DIALING=DISABLED", "--env", "PRODUCTION_DIALING=DISABLED",
            "--env", "SEND_EVENTS=false", "--env", "ENABLE_EXTERNAL_DELIVERY=false",
            "--env", "LIVE_WRITE=false", "--env", "ODOO_WRITE=false",
            "--env", "N8N_DELIVERY_ENABLED=false", subject,
        ], timeout=120)
        run_bytes(["/usr/bin/docker", "start", STANDBY_CONTAINER], timeout=60)
    current = docker_inspect(STANDBY_CONTAINER)
    if current["Config"]["Image"] != subject or current["HostConfig"]["NetworkMode"] != "none":
        raise OperatorError("standby isolation read-back failed")
    time.sleep(5)
    if not docker_inspect(STANDBY_CONTAINER)["State"]["Running"]:
        raise OperatorError("standby exited during startup")
    return {"subject": subject, "network_mode": "none"}


def certify_standby(config: dict[str, str]) -> dict[str, object]:
    current = docker_inspect(STANDBY_CONTAINER)
    subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    if current["Config"]["Image"] != subject or current["HostConfig"]["NetworkMode"] != "none" or not current["State"]["Running"]:
        raise OperatorError("standby certification mismatch")
    return {"subject": subject, "network_mode": "none"}


def remove_standby(config: dict[str, str]) -> dict[str, object]:
    try:
        current = docker_inspect(STANDBY_CONTAINER)
    except subprocess.CalledProcessError:
        return {"candidate_present": False}
    subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    if current["Config"]["Image"] != subject:
        raise OperatorError("standby is outside the installed release tuple")
    run_bytes(["/usr/bin/docker", "stop", "--time", "20", STANDBY_CONTAINER], timeout=60)
    run_bytes(["/usr/bin/docker", "rm", STANDBY_CONTAINER], timeout=60)
    return {"candidate_present": False}


def safety_state() -> dict[str, object]:
    channel = run_fixed(
        ["/usr/bin/ssh", "codestra-vicidial", VICIDIAL_CHANNELS_COMMAND]
    )
    registrations = run_fixed(
        ["/usr/bin/ssh", "codestra-vicidial", VICIDIAL_REGISTRATIONS_COMMAND]
    )
    runtime = run_fixed(
        [
            "/usr/bin/docker",
            "inspect",
            "codestra-middleware-1",
            "--format",
            "{{json .Config.Env}}",
        ]
    )
    runtime_flags: dict[str, str] = {}
    if runtime.returncode == 0:
        try:
            for entry in json.loads(runtime.stdout):
                name, separator, value = entry.partition("=")
                if separator:
                    runtime_flags[name] = value
        except (json.JSONDecodeError, TypeError):
            runtime_flags = {}
    flags_false = all(
        runtime_flags.get(name) == "false" for name in CANONICAL_FALSE_FLAGS
    )
    calls = re.findall(r"(?m)^([0-9]+) active calls$", channel.stdout)
    channels = re.findall(r"(?m)^([0-9]+) active channels$", channel.stdout)
    return {
        "pstatus": run_fixed(["/usr/bin/systemctl", "is-system-running"]).returncode,
        "telephony_probe_pass": channel.returncode == 0 and registrations.returncode == 0,
        "active_calls_zero": calls == ["0"],
        "active_channels_zero": channels == ["0"],
        "required_runtime_flags_false": flags_false,
        "sip_registration_performed": "No objects found." not in registrations.stdout,
    }


def execute(action: str) -> tuple[int, dict[str, object]]:
    if action not in ALLOWED_ACTIONS:
        raise OperatorError("action is not allowlisted")
    config = load_release_config()
    window: dict[str, str] | None = None
    if action not in READ_ONLY_ACTIONS | RECOVERY_ACTIONS:
        window = require_maintenance_window()
        if window["maintenance_date"] != config["maintenance_date"]:
            raise OperatorError("maintenance date does not match release tuple")
    elif action in READ_ONLY_ACTIONS:
        try:
            window = require_maintenance_window()
        except OperatorError:
            window = {
                "maintenance_date": config["maintenance_date"],
                "maintenance_window": "OUTSIDE_APPROVED_WINDOW",
                "owner_window_waiver_evidence": "FAIL",
                "window_check": "DENIED",
            }
    state = safety_state()
    safe_for_activation = (
        state["telephony_probe_pass"]
        and state["active_calls_zero"]
        and state["active_channels_zero"]
        and state["required_runtime_flags_false"]
        and not state["sip_registration_performed"]
    )
    if action not in SAFETY_BYPASS_ACTIONS and not safe_for_activation:
        raise OperatorError("runtime safety state is not fail-closed")
    result: dict[str, object] = {
        "action": action,
        "maintenance_date": None if window is None else window["maintenance_date"],
        "window": window,
        "release": config,
        "safety": state,
    }
    if action in SYSTEMD_ACTIONS:
        unit = SYSTEMD_ACTIONS[action]
        invocation = run_fixed(["/usr/bin/systemctl", "start", "--wait", unit])
        result.update({"unit": unit, "returncode": invocation.returncode})
        if invocation.returncode != 0:
            raise OperatorError(f"fixed unit failed: {unit}")
    elif action == "validate-backup":
        result.update(validate_backup_state())
    elif action == "stage":
        result.update(stage_standby(config))
    elif action == "canary":
        result.update(certify_standby(config))
    elif action == "rollback":
        result.update(remove_standby(config))
    elif action in {"preflight", "status"}:
        invocation = run_fixed(["/usr/bin/systemctl", "--failed", "--no-legend", "--plain"])
        result.update({"returncode": invocation.returncode, "failed_units_present": bool(invocation.stdout.strip())})
        if action == "preflight" and result["failed_units_present"]:
            raise OperatorError("preflight found failed units")
    else:
        invocation = run_fixed(["/usr/bin/docker", "ps", "--format", "{{.Names}}|{{.Image}}|{{.Status}}"])
        result.update({"returncode": invocation.returncode, "container_inventory_collected": invocation.returncode == 0})
        if invocation.returncode != 0:
            raise OperatorError("evidence collection failed")
    return 0, result


def write_evidence(action: str, status_value: str, detail: dict[str, object]) -> Path:
    EVIDENCE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = EVIDENCE_DIR.lstat()
    if (
        stat.S_ISLNK(info.st_mode)
        or info.st_uid != 0
        or info.st_gid != 0
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise OperatorError("evidence directory is unsafe")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    target = EVIDENCE_DIR / f"{stamp}-{os.getpid()}-{action}.json"
    payload = {"schema": "codestra.production-operator.v1", "status": status_value, **detail}
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        json.dump(payload, stream, sort_keys=True, separators=(",", ":"))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    return target


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("operator rejected: root execution required", file=sys.stderr)
        return 2
    if len(argv) != 1 or argv[0] not in ALLOWED_ACTIONS:
        print("operator rejected: exactly one allowlisted action is required", file=sys.stderr)
        return 2
    action = argv[0]
    LOCK_FILE.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    descriptor = os.open(
        LOCK_FILE,
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    with os.fdopen(descriptor, "a+", encoding="ascii") as lock:
        lock_info = os.fstat(lock.fileno())
        if lock_info.st_uid != 0 or stat.S_IMODE(lock_info.st_mode) != 0o600:
            print("operator rejected: unsafe lock file", file=sys.stderr)
            return 2
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            _, result = execute(action)
            evidence = write_evidence(action, "PASS", result)
            print(f"OPERATOR_RESULT=PASS\nACTION={action}\nEVIDENCE={evidence}")
            return 0
        except Exception as error:
            detail = {"action": action, "error_class": type(error).__name__}
            try:
                evidence = write_evidence(action, "FAIL", detail)
                print(f"EVIDENCE={evidence}", file=sys.stderr)
            except Exception:
                pass
            print(f"operator rejected: {type(error).__name__}", file=sys.stderr)
            return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
