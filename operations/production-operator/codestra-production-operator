    "PRODUCTION_DIALING",
    "LIVE_CALL_CONTROL",
    "GENERAL_AI_DIALING",
}
SYSTEMD_ACTIONS = {
    "backup": "codestra-readiness-backup.service",
    "restore-test": "codestra-readiness-restore.service",
}
BACKUP_STATE_VALIDATOR = Path("/opt/codestra/operations/backup/check-backup-state.sh")
CONFIG_DIR = Path("/etc/codestra/production-operator")
RELEASE_CONFIG = CONFIG_DIR / "release.json"
MAINTENANCE_DATE = CONFIG_DIR / "maintenance-date"
OWNER_WAIVER_DIR = Path(
    "/opt/codestra/evidence/production-readiness-soak/20260822T022734Z"
)
OWNER_WINDOW_WAIVER = OWNER_WAIVER_DIR / "OWNER-MAINTENANCE-WINDOW-WAIVER.txt"
OWNER_WINDOW_WAIVER_CHECKSUM = OWNER_WAIVER_DIR / "OWNER-MAINTENANCE-WINDOW-WAIVER.sha256"
EVIDENCE_DIR = Path("/var/lib/codestra-production-operator/evidence")
LOCK_FILE = Path("/run/lock/codestra-production-operator.lock")
DATE_RE = re.compile(r"20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])")
