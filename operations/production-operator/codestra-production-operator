def validate_backup_state() -> dict[str, object]:
    info = BACKUP_STATE_VALIDATOR.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise OperatorError("backup-state validator has unsafe file type")
    if info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o755:
        raise OperatorError("backup-state validator has unsafe ownership or mode")
    invocation = run_fixed([
        "/usr/bin/env",
        f"CODESTRA_BACKUP_ROOT={READINESS_BACKUP_ROOT}",
        str(BACKUP_STATE_VALIDATOR),
    ])
    if invocation.returncode != 0:
        raise OperatorError("backup-state validation failed")
    stamp = checked_root_file(READINESS_BACKUP_ROOT / "LAST_SUCCESS")
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", stamp) is None:
        raise OperatorError("readiness backup marker is malformed")
    backup_dir = READINESS_BACKUP_ROOT / stamp
    try:
        directory_info = backup_dir.lstat()
    except OSError as error:
        raise OperatorError("readiness backup directory unavailable") from error
    if (
        stat.S_ISLNK(directory_info.st_mode)
        or not stat.S_ISDIR(directory_info.st_mode)
        or directory_info.st_uid != 0
        or directory_info.st_gid != 0
        or stat.S_IMODE(directory_info.st_mode) != 0o700
    ):
        raise OperatorError("readiness backup directory is unsafe")
    checksum_text = checked_root_file(backup_dir / "EVIDENCE-SHA256SUMS")
    expected_names = {f"codestra-{stamp}.tar.gz.gpg", "SHA256SUMS", "STATUS.txt"}
    records: dict[str, str] = {}
    for line in checksum_text.splitlines():
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9._-]+)", line)
        if match is None or match.group(2) in records:
            raise OperatorError("readiness backup evidence manifest is malformed")
        records[match.group(2)] = match.group(1)
    if set(records) != expected_names:
        raise OperatorError("readiness backup evidence manifest is incomplete")
    for name, expected in records.items():
        actual = hashlib.sha256(checked_root_bytes(backup_dir / name)).hexdigest()
        if actual != expected:
            raise OperatorError("readiness backup evidence checksum mismatch")
    return {
        "validator": str(BACKUP_STATE_VALIDATOR),
        "returncode": 0,
        "backup_stamp": stamp,
        "evidence_integrity": "PASS",
    }


