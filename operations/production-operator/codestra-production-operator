        "-d", CONTROL_PLANE_DB, "-Atc",
        "set search_path to control_plane; select count(*) from messages where channel='email' and status in ('accepted','sent','delivered');",
    ], timeout=30).stdout.decode().strip())
    queued_email_count = lambda: int(run_bytes([
        "/usr/bin/docker", "exec", CONTROL_PLANE_DB_CONTAINER, "psql", "-U", "postgres",
        "-d", CONTROL_PLANE_DB, "-Atc",
        "set search_path to control_plane; select count(*) from messages where channel='email' and status='queued';",
    ], timeout=30).stdout.decode().strip())
    before = email_delivery_count()
    if enabled and queued_email_count() != 0:
        raise OperatorError("queued email must be zero before Klyrow activation")
    try:
        run_bytes([*compose, "up", "--detach", "--no-build", "api", "worker"], timeout=300)
        wait_control_plane_health()
        expected = {
            "KLYROW_MODE": "production" if enabled else "test",
            "LIVE_EMAIL_DELIVERY": "true" if enabled else "false",
            "CONTROL_PLANE_PRODUCTION_DELIVERY_AUTHORIZED": "true" if enabled else "false",
        }
        for container in (CONTROL_PLANE_API, CONTROL_PLANE_WORKER):
            inspected = docker_inspect(container)
            if inspected["State"].get("Health", {}).get("Status") != "healthy":
                raise OperatorError(f"Klyrow email runtime unhealthy: {container}")
            env = dict(item.split("=", 1) for item in inspected["Config"].get("Env", []) if "=" in item)
            if any(env.get(key) != value for key, value in expected.items()):
                raise OperatorError(f"Klyrow email flag readback mismatch: {container}")
        after = email_delivery_count()
        if enabled and after != before:
            raise OperatorError("email delivery ledger changed during activation")
        atomic_root_json(KLYROW_EMAIL_POINTER, {
            "enabled": enabled, "protected_sha": config["protected_sha"],
            "updated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        }, mode=0o600)
    except Exception:
        if enabled:
            run_bytes(["/usr/bin/docker", "compose", "--project-name", CONTROL_PLANE_PROJECT,
                       "--file", str(base), "--file", str(safety), "up", "--detach",
                       "--no-build", "api", "worker"], timeout=300)
        raise
    return {**authorization, "klyrow_mode": expected["KLYROW_MODE"],
            "live_email_delivery": expected["LIVE_EMAIL_DELIVERY"],
            "email_delivery_ledger_before": before, "email_delivery_ledger_after": after,
            "messages_sent_during_activation": after - before}


def checked_operator_bytes(path: Path, *, expected_mode: int) -> bytes:
    """Read a no-follow file owned by the effective operator identity."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise OperatorError(f"operator state unavailable: {path}") from error
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise OperatorError(f"operator state type unsafe: {path}")
        if info.st_uid != os.geteuid() or info.st_gid != os.getegid():
            raise OperatorError(f"operator state ownership unsafe: {path}")
        if stat.S_IMODE(info.st_mode) != expected_mode:
            raise OperatorError(f"operator state mode unsafe: {path}")
        return stream.read()


def fsync_directory(path: Path) -> None:
    descriptor = os.open(
        path,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_root_bytes(path: Path, payload: bytes, *, mode: int) -> None:
    """Atomically publish and read back root-operator state."""
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    descriptor = os.open(
        temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode
    )
    try:
        with os.fdopen(descriptor, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)
    if checked_operator_bytes(path, expected_mode=mode) != payload:
        raise OperatorError(f"operator state readback mismatch: {path}")


def atomic_root_text(path: Path, value: str, *, mode: int) -> None:
    try:
        payload = value.encode("ascii")
    except UnicodeError as error:
        raise OperatorError("operator state is not ASCII") from error
    atomic_root_bytes(path, payload, mode=mode)


def atomic_root_json(
    path: Path,
    payload: dict[str, object],
    *,
    mode: int = 0o644,
) -> None:
    """Commit a small root-owned state pointer without a partial-write window."""
    encoded = (json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )
    atomic_root_bytes(path, encoded, mode=mode)


def validate_control_plane_rollback() -> dict[str, str]:
    """Validate every artifact consumed by the bounded rollback operation."""
    stamp = checked_root_file(CONTROL_PLANE_BACKUP_ROOT / "LAST_SUCCESS")
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", stamp) is None:
        raise OperatorError("control-plane rollback marker malformed")
    backup = CONTROL_PLANE_BACKUP_ROOT / stamp
    info = backup.lstat()
    if (
        backup.is_symlink()
        or not stat.S_ISDIR(info.st_mode)
        or info.st_uid != 0
        or info.st_gid != 0
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise OperatorError("control-plane rollback directory is unsafe")
    owner = checked_root_file(backup / "database-owner")
    if re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", owner) is None:
        raise OperatorError("control-plane rollback database owner is malformed")
    dump = checked_root_bytes(backup / "control-plane.sql")
    if not dump:
        raise OperatorError("control-plane rollback database dump is empty")
    expected_dump_digest = checked_root_file(backup / "control-plane.sql.sha256")
    if re.fullmatch(r"[0-9a-f]{64}", expected_dump_digest) is None:
        raise OperatorError("control-plane rollback database checksum is malformed")
    if not hmac.compare_digest(hashlib.sha256(dump).hexdigest(), expected_dump_digest):
        raise OperatorError("control-plane rollback database checksum mismatch")
    for label in ("api", "worker"):
        image_id = checked_root_file(backup / f"{label}-image-id")
        if re.fullmatch(r"sha256:[0-9a-f]{64}", image_id) is None:
            raise OperatorError("control-plane rollback image id is malformed")
        tagged = docker_inspect(f"codestra/{CONTROL_PLANE_PROJECT}-{label}:rollback-{stamp}")
        if tagged.get("Id") != image_id:
            raise OperatorError("control-plane rollback image tag mismatch")
    return {"rollback_stamp": stamp, "rollback_bundle": "PASS"}


def require_action_evidence(action: str, config: dict[str, str]) -> Path:
    """Require a prior PASS produced by this operator for the exact tuple."""
    if not EVIDENCE_DIR.is_dir() or EVIDENCE_DIR.is_symlink():
        raise OperatorError(f"{action} evidence directory unavailable")
    for candidate in sorted(EVIDENCE_DIR.glob(f"*-{action}.json"), reverse=True):
        try:
            info = candidate.lstat()
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0
                or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) != 0o600
            ):
                continue
            payload = json.loads(
                checked_operator_bytes(candidate, expected_mode=0o600).decode("utf-8")
            )
        except (OSError, UnicodeError, json.JSONDecodeError):
            continue
        if payload.get("status") == "PASS" and payload.get("release") == config:
            return candidate
    raise OperatorError(f"exact-tuple {action} evidence unavailable")


def require_evidence_value(path: Path, key: str, expected: object) -> None:
    try:
        payload = json.loads(
            checked_operator_bytes(path, expected_mode=0o600).decode("utf-8")
        )
    except (UnicodeError, json.JSONDecodeError) as error:
        raise OperatorError("operator evidence is malformed") from error
    if payload.get(key) != expected:
        raise OperatorError(f"operator evidence {key} mismatch")


def verify_middleware_runtime(config: dict[str, str]) -> dict[str, str]:
    expected = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    for container in MIDDLEWARE_RUNTIME_CONTAINERS:
        current = docker_inspect(container)
        if current["Config"]["Image"] != expected:
            raise OperatorError(f"middleware runtime digest mismatch: {container}")
        health = current["State"].get("Health", {}).get("Status")
        if health != "healthy":
            raise OperatorError(f"middleware runtime unhealthy: {container}")
        environment = dict(
            item.split("=", 1) for item in current["Config"].get("Env", []) if "=" in item
        )
        if any(environment.get(name) != "false" for name in MIDDLEWARE_REQUIRED_FALSE_FLAGS):
            raise OperatorError(f"middleware runtime delivery flag unsafe: {container}")
    return {"middleware_subject": expected, "middleware_runtime_digest": "PASS"}


def verified_middleware_compose_layer(path: Path, expected: str) -> bytes:
    """Read an approved layer once without following a replaceable pathname."""
    allowed_owners = {0, pwd.getpwnam("codestra-admin").pw_uid}
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise OperatorError(f"middleware Compose layer unavailable: {path}") from error
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid not in allowed_owners
            or info.st_mode & 0o022
        ):
            raise OperatorError(f"middleware Compose layer is unsafe: {path}")
        content = stream.read(2 * 1024 * 1024)
        if stream.read(1):
            raise OperatorError(f"middleware Compose layer is too large: {path}")
    if not hmac.compare_digest(hashlib.sha256(content).hexdigest(), expected):
        raise OperatorError(f"middleware Compose layer checksum mismatch: {path}")
    return content


def checked_middleware_compose_layers(config: dict[str, str]) -> list[Path]:
    """Copy verified layers to an immutable root-owned exact-release directory."""
    trusted = MIDDLEWARE_COMPOSE_RELEASE_ROOT / config["protected_sha"]
    names = [f"{index:02d}-{path.name}" for index, (path, _) in enumerate(MIDDLEWARE_COMPOSE_LAYERS, 1)]
    if trusted.exists() or trusted.is_symlink():
        info = trusted.lstat()
        if (
            trusted.is_symlink()
            or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise OperatorError("trusted Middleware Compose directory is unsafe")
        paths = [trusted / name for name in names]
        for copied, (_, expected) in zip(paths, MIDDLEWARE_COMPOSE_LAYERS):
            if not hmac.compare_digest(
                hashlib.sha256(checked_root_bytes(copied)).hexdigest(), expected
            ):
                raise OperatorError("trusted Middleware Compose checksum mismatch")
        return paths
    MIDDLEWARE_COMPOSE_RELEASE_ROOT.mkdir(mode=0o755, parents=True, exist_ok=True)
    root_info = MIDDLEWARE_COMPOSE_RELEASE_ROOT.lstat()
    if (
        MIDDLEWARE_COMPOSE_RELEASE_ROOT.is_symlink()
        or not stat.S_ISDIR(root_info.st_mode)
        or root_info.st_uid != 0
        or root_info.st_gid != 0
        or stat.S_IMODE(root_info.st_mode) != 0o755
    ):
        raise OperatorError("Middleware Compose release root is unsafe")
    candidate = Path(tempfile.mkdtemp(prefix=f".{config['protected_sha']}.", dir=MIDDLEWARE_COMPOSE_RELEASE_ROOT))
    try:
        os.chmod(candidate, 0o700)
        for name, (source, expected) in zip(names, MIDDLEWARE_COMPOSE_LAYERS):
            content = verified_middleware_compose_layer(source, expected)
            destination = candidate / name
            descriptor = os.open(
                destination,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
            )
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(content)
                stream.flush()
                os.fsync(stream.fileno())
        candidate.rename(trusted)
    except Exception:
        shutil.rmtree(candidate, ignore_errors=True)
        raise
    return [trusted / name for name in names]


def middleware_compose(config: dict[str, str], *, rollback_override: Path | None = None) -> list[str]:
    layers = checked_middleware_compose_layers(config)
    _, release = control_plane_paths(config)
    approved = release / "deploy/middleware/compose.approved-release.yaml"
    if rollback_override is None:
        approved_text = checked_root_file(approved, expected_mode=0o644)
        expected_subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
        if approved_text.count(expected_subject) != 1:
            raise OperatorError("approved Middleware override does not bind the exact digest")
        layers.append(approved)
    else:
        checked_root_bytes(rollback_override)
        layers.append(rollback_override)
    command = [
        "/usr/bin/docker",
        "compose",
        "--project-name",
        MIDDLEWARE_PROJECT,
        "--project-directory",
        str(MIDDLEWARE_PROJECT_DIRECTORY),
    ]
    for layer in layers:
        command.extend(("--file", str(layer)))
    return command


def validate_middleware_compose(config: dict[str, str], compose: list[str]) -> None:
    try:
        rendered = json.loads(run_bytes([*compose, "config", "--format", "json"], timeout=120).stdout)
    except (json.JSONDecodeError, subprocess.CalledProcessError) as error:
        raise OperatorError("Middleware Compose rendering failed") from error
    services = rendered.get("services")
    expected_subject = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    if not isinstance(services, dict):
        raise OperatorError("Middleware Compose service graph is malformed")
    for service in MIDDLEWARE_RUNTIME_SERVICES:
        definition = services.get(service)
        if not isinstance(definition, dict) or definition.get("image") != expected_subject:
            raise OperatorError(f"Middleware Compose digest mismatch: {service}")
        environment = definition.get("environment")
        if not isinstance(environment, dict):
            raise OperatorError(f"Middleware Compose environment unavailable: {service}")
        if any(str(environment.get(name, "")).lower() != "false" for name in MIDDLEWARE_REQUIRED_FALSE_FLAGS):
            raise OperatorError(f"Middleware Compose delivery flag unsafe: {service}")


def wait_middleware_health(timeout_seconds: int = 180) -> None:
    deadline = time.monotonic() + timeout_seconds
    pending = set(MIDDLEWARE_RUNTIME_CONTAINERS)
    while pending and time.monotonic() < deadline:
        for container in tuple(pending):
            status_value = docker_inspect(container)["State"].get("Health", {}).get("Status")
            if status_value == "healthy":
                pending.remove(container)
            elif status_value == "unhealthy":
                raise OperatorError(f"Middleware runtime became unhealthy: {container}")
        if pending:
            time.sleep(2)
    if pending:
        raise OperatorError("Middleware runtime health check timed out")


def middleware_rollback_target(stamp: str) -> dict[str, str]:
    target = MIDDLEWARE_BACKUP_ROOT / stamp / "rollout-target.json"
    try:
        value = json.loads(checked_root_file(target))
    except json.JSONDecodeError as error:
        raise OperatorError("Middleware rollback target is malformed") from error
    if not isinstance(value, dict) or set(value) != {
        "protected_sha", "image_digest", "change_id", "maintenance_date"
    }:
        raise OperatorError("Middleware rollback target schema mismatch")
    return value


def reusable_middleware_snapshot(config: dict[str, str]) -> str | None:
    """Reuse only an active attempt; a completed rollback needs fresh state."""
    if not (MIDDLEWARE_ROLLBACK_MARKER.exists() or MIDDLEWARE_ROLLBACK_MARKER.is_symlink()):
        return None
    previous_stamp = checked_root_file(MIDDLEWARE_ROLLBACK_MARKER)
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", previous_stamp) is None:
        raise OperatorError("Middleware rollback marker malformed")
    if middleware_rollback_target(previous_stamp) != config:
        return None
    bundle = validate_middleware_rollback(config)
    progress = middleware_rollback_progress(MIDDLEWARE_BACKUP_ROOT / previous_stamp)
    if progress is not None and progress["phase"] == "COMPLETE":
        verify_middleware_rollback_readback(bundle)
        return None
    return previous_stamp


def middleware_database_client_canonical(container: str) -> str | None:
    match = re.fullmatch(
        r"(codestra-middleware(?:-[a-z0-9-]+)?)-([1-9][0-9]*)",
        container,
    )
    if match is None:
        return None
    return f"{match.group(1)}-1"


def middleware_database_client_state() -> dict[str, bool]:
    """Read every replica of each database-using service in the approved graph."""
    output = run_bytes([
        "/usr/bin/docker",
        "ps",
        "--all",
        "--format",
        "{{.Names}}",
    ], timeout=30).stdout.decode().splitlines()
    names = tuple(value.strip() for value in output if value.strip())
    if (
        len(names) != len(set(names))
        or any(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", name) is None for name in names)
    ):
        raise OperatorError("Docker container inventory is malformed")
    observed_middleware = {
        name for name in names if name.startswith("codestra-middleware")
    }
    known = set(MIDDLEWARE_DATABASE_CLIENT_CONTAINERS)
    canonical = {
        name: middleware_database_client_canonical(name)
        for name in observed_middleware
    }
    unknown = {
        name for name, service in canonical.items() if service not in known
    }
    if unknown:
        raise OperatorError("Unclassified Middleware database client requires review")
    state: dict[str, bool] = {}
    for service in MIDDLEWARE_DATABASE_CLIENT_CONTAINERS:
        replicas = sorted(
            (
                name
                for name, candidate in canonical.items()
                if candidate == service
            ),
            key=lambda name: int(name.rsplit("-", 1)[1]),
        )
        for container in replicas:
            running = docker_inspect(container).get("State", {}).get("Running")
            if not isinstance(running, bool):
                raise OperatorError(
                    f"Middleware database client state unavailable: {container}"
                )
            state[container] = running
    return state


def middleware_quiescence_stamp() -> str | None:
    if not (MIDDLEWARE_QUIESCE_MARKER.exists() or MIDDLEWARE_QUIESCE_MARKER.is_symlink()):
        return None
    stamp = checked_root_file(MIDDLEWARE_QUIESCE_MARKER)
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", stamp) is None:
        raise OperatorError("Middleware quiescence marker malformed")
    return stamp


def quiesce_middleware_database_clients(stamp: str) -> tuple[str, ...]:
    """Stop the closed set of Middleware DB clients and publish crash state."""
    current_stamp = middleware_quiescence_stamp()
    if current_stamp is not None and current_stamp != stamp:
        raise OperatorError("A different Middleware quiescence attempt is active")
    if current_stamp is None:
        atomic_root_text(MIDDLEWARE_QUIESCE_MARKER, stamp + "\n", mode=0o600)
    state = middleware_database_client_state()
    running = tuple(container for container, value in state.items() if value)
    if running:
        run_bytes([
            "/usr/bin/docker",
            "stop",
            "--time",
            "30",
            *running,
        ], timeout=900)
    remaining = [
        container
        for container, value in middleware_database_client_state().items()
        if value
    ]
    if remaining:
        raise OperatorError("Middleware database clients did not quiesce")
    return running


def clear_middleware_quiescence(stamp: str) -> None:
    if middleware_quiescence_stamp() != stamp:
        raise OperatorError("Middleware quiescence marker does not match rollback point")
    MIDDLEWARE_QUIESCE_MARKER.unlink()
    fsync_directory(MIDDLEWARE_BACKUP_ROOT)


def validate_middleware_database_client_names(containers: tuple[str, ...]) -> None:
    known = set(MIDDLEWARE_DATABASE_CLIENT_CONTAINERS)
    unknown = {
        container
        for container in containers
        if middleware_database_client_canonical(container) not in known
    }
    if unknown or len(containers) != len(set(containers)):
        raise OperatorError("Middleware database client set is malformed")


def wait_middleware_database_clients(
    containers: tuple[str, ...], timeout_seconds: int = 180
) -> None:
    """Require every resumed client to remain running across two read-backs."""
    validate_middleware_database_client_names(containers)
    deadline = time.monotonic() + timeout_seconds
    stable_observations = 0
    while time.monotonic() < deadline:
        ready = True
        for container in containers:
            state = docker_inspect(container).get("State")
            if not isinstance(state, dict) or not isinstance(state.get("Running"), bool):
                raise OperatorError(
                    f"Middleware database client state unavailable: {container}"
                )
            if state["Running"] is not True:
                raise OperatorError(
                    f"Middleware database client did not remain running: {container}"
                )
            health = state.get("Health")
            if health is not None:
                if not isinstance(health, dict) or health.get("Status") not in {
                    "starting", "healthy", "unhealthy"
                }:
                    raise OperatorError(
                        f"Middleware database client health unavailable: {container}"
                    )
                if health["Status"] == "unhealthy":
                    raise OperatorError(
                        f"Middleware database client became unhealthy: {container}"
                    )
                if health["Status"] != "healthy":
                    ready = False
        stable_observations = stable_observations + 1 if ready else 0
        if stable_observations >= 2:
            return
        time.sleep(2)
    raise OperatorError("Middleware database client health check timed out")


def resume_middleware_database_clients(stamp: str, containers: tuple[str, ...]) -> None:
    validate_middleware_database_client_names(containers)
    state = middleware_database_client_state()
    if any(container not in state for container in containers):
        raise OperatorError("Captured Middleware database client is unavailable")
    stopped = tuple(container for container in containers if not state[container])
    if stopped:
        run_bytes(["/usr/bin/docker", "start", *stopped], timeout=900)
    readback = middleware_database_client_state()
    if any(not readback[container] for container in containers):
        raise OperatorError("Middleware database clients did not resume")
    wait_middleware_database_clients(containers)
    clear_middleware_quiescence(stamp)


def recover_stale_middleware_quiescence() -> None:
    """Recover a crash that occurred before a rollback bundle was published."""
    stamp = middleware_quiescence_stamp()
    if stamp is None:
        return
    backup = MIDDLEWARE_BACKUP_ROOT / stamp
    clients_path = backup / "database-clients-running.json"
    limit_path = backup / "database-connection-limit"
    if not clients_path.exists() or not limit_path.exists():
        raise OperatorError("Incomplete Middleware quiescence evidence requires operator review")
    try:
        clients_value = json.loads(checked_root_file(clients_path))
    except json.JSONDecodeError as error:
        raise OperatorError("Middleware database client state is malformed") from error
    if not isinstance(clients_value, dict) or set(clients_value) != {"containers"}:
        raise OperatorError("Middleware database client state schema mismatch")
    containers = clients_value["containers"]
    if not isinstance(containers, list) or any(not isinstance(item, str) for item in containers):
        raise OperatorError("Middleware database client state is malformed")
    connection_limit = checked_root_file(limit_path)
    if re.fullmatch(r"-1|[0-9]{1,10}", connection_limit) is None:
        raise OperatorError("Middleware rollback connection limit is malformed")
    set_middleware_database_connection_limit(connection_limit)
    resume_middleware_database_clients(stamp, tuple(containers))


def snapshot_middleware_runtime(config: dict[str, str], readiness_backup_stamp: str) -> str:
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", readiness_backup_stamp) is None:
        raise OperatorError("readiness backup reference is malformed")
    previous_stamp = reusable_middleware_snapshot(config)
    if previous_stamp is not None:
        return previous_stamp
    recover_stale_middleware_quiescence()
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = MIDDLEWARE_BACKUP_ROOT / stamp
    backup.mkdir(mode=0o700, parents=True)
    fsync_directory(MIDDLEWARE_BACKUP_ROOT)
    override = backup / "rollback.override.yaml"
    lines = ["services:"]
    for service, container in MIDDLEWARE_RUNTIME_SERVICES.items():
        current = docker_inspect(container)
        image_id = str(current.get("Image", ""))
        if re.fullmatch(r"sha256:[0-9a-f]{64}", image_id) is None:
            raise OperatorError(f"Middleware rollback image ID malformed: {container}")
        tag = f"codestra/middleware-{service}:rollback-{stamp}"
        run_bytes(["/usr/bin/docker", "tag", image_id, tag], timeout=60)
        lines.extend((f"  {service}:", f"    image: {tag}"))
        atomic_root_text(backup / f"{service}.image-id", image_id + "\n", mode=0o600)
    database_owner = run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-Atc",
        f"select pg_get_userbyid(datdba) from pg_database where datname='{MIDDLEWARE_DB}'",
    ], timeout=30).stdout.decode().strip()
    if re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", database_owner) is None:
        raise OperatorError("Middleware database owner readback failed")
    database_allows_connections = run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-Atc",
        f"select case when datallowconn then 'true' else 'false' end from pg_database where datname='{MIDDLEWARE_DB}'",
    ], timeout=30).stdout.decode().strip()
    if database_allows_connections not in {"true", "false"}:
        raise OperatorError("Middleware database connection policy readback failed")
    database_connection_limit = run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-Atc",
        f"select datconnlimit from pg_database where datname='{MIDDLEWARE_DB}'",
    ], timeout=30).stdout.decode().strip()
    if re.fullmatch(r"-1|[0-9]{1,10}", database_connection_limit) is None:
        raise OperatorError("Middleware database connection limit readback failed")
    database_head = middleware_database_revision()
    database_clients_running = tuple(
        container
        for container, running in middleware_database_client_state().items()
        if running
    )
    atomic_root_text(backup / "database-owner", database_owner + "\n", mode=0o600)
    atomic_root_text(
        backup / "database-allows-connections",
        database_allows_connections + "\n",
        mode=0o600,
    )
    atomic_root_text(
        backup / "database-connection-limit",
        database_connection_limit + "\n",
        mode=0o600,
    )
    atomic_root_text(backup / "database-head", database_head + "\n", mode=0o600)
    atomic_root_json(
        backup / "database-clients-running.json",
        {"containers": list(database_clients_running)},
        mode=0o600,
    )
    atomic_root_text(
        backup / "readiness-backup-stamp",
        readiness_backup_stamp + "\n",
        mode=0o600,
    )
    atomic_root_text(override, "\n".join(lines) + "\n", mode=0o600)
    atomic_root_text(
        backup / "rollout-target.json",
        json.dumps(config, sort_keys=True, separators=(",", ":")) + "\n",
        mode=0o600,
    )
    fsync_directory(backup)
    quiesced = True
    try:
        quiesce_middleware_database_clients(stamp)
        if not fence_middleware_database_clients():
            raise OperatorError("Middleware database missing before pre-change snapshot")
        database_digest, _ = stream_command_to_atomic_file(
            [
                "/usr/bin/docker",
                "exec",
                MIDDLEWARE_DB_CONTAINER,
                "pg_dump",
                "-U",
                "postgres",
                "-Fc",
                MIDDLEWARE_DB,
            ],
            backup / "middleware.dump",
            timeout=1800,
        )
        atomic_root_text(
            backup / "middleware.dump.sha256",
            database_digest + "\n",
            mode=0o600,
        )
        set_middleware_database_connection_limit(database_connection_limit)
        fsync_directory(backup)
        atomic_root_text(MIDDLEWARE_ROLLBACK_MARKER, stamp + "\n", mode=0o600)
    except Exception:
        if quiesced:
            set_middleware_database_connection_limit(database_connection_limit)
            resume_middleware_database_clients(stamp, database_clients_running)
        raise
    return stamp


def validate_middleware_rollback(config: dict[str, str]) -> dict[str, object]:
    stamp = checked_root_file(MIDDLEWARE_ROLLBACK_MARKER)
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", stamp) is None:
        raise OperatorError("Middleware rollback marker malformed")
    backup = MIDDLEWARE_BACKUP_ROOT / stamp
    info = backup.lstat()
    if (
        backup.is_symlink()
        or not stat.S_ISDIR(info.st_mode)
        or info.st_uid != 0
        or info.st_gid != 0
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise OperatorError("Middleware rollback directory is unsafe")
    rollback_target = middleware_rollback_target(stamp)
    if rollback_target != config:
        raise OperatorError("Middleware rollback target does not match the exact release")
    image_ids: dict[str, str] = {}
    for service in MIDDLEWARE_RUNTIME_SERVICES:
        image_id = checked_root_file(backup / f"{service}.image-id")
        if re.fullmatch(r"sha256:[0-9a-f]{64}", image_id) is None:
            raise OperatorError("Middleware rollback image ID malformed")
        tag = docker_inspect(f"codestra/middleware-{service}:rollback-{stamp}")
        if tag.get("Id") != image_id:
            raise OperatorError("Middleware rollback image tag mismatch")
        image_ids[service] = image_id
    override = backup / "rollback.override.yaml"
    override_digest = hashlib.sha256(checked_root_bytes(override)).hexdigest()
    database_owner = checked_root_file(backup / "database-owner")
    if re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", database_owner) is None:
        raise OperatorError("Middleware rollback database owner is malformed")
    database_allows_connections = checked_root_file(backup / "database-allows-connections")
    if database_allows_connections not in {"true", "false"}:
        raise OperatorError("Middleware rollback connection policy is malformed")
    database_connection_limit = checked_root_file(backup / "database-connection-limit")
    if re.fullmatch(r"-1|[0-9]{1,10}", database_connection_limit) is None:
        raise OperatorError("Middleware rollback connection limit is malformed")
    database_head = checked_root_file(backup / "database-head")
    if re.fullmatch(r"[0-9a-z_]{1,80}", database_head) is None:
        raise OperatorError("Middleware rollback database head is malformed")
    try:
        database_clients_value = json.loads(
            checked_root_file(backup / "database-clients-running.json")
        )
    except json.JSONDecodeError as error:
        raise OperatorError("Middleware database client state is malformed") from error
    if (
        not isinstance(database_clients_value, dict)
        or set(database_clients_value) != {"containers"}
        or not isinstance(database_clients_value["containers"], list)
        or any(not isinstance(item, str) for item in database_clients_value["containers"])
    ):
        raise OperatorError("Middleware database client state schema mismatch")
    database_clients_running = tuple(database_clients_value["containers"])
    validate_middleware_database_client_names(database_clients_running)
    readiness_backup_stamp = checked_root_file(backup / "readiness-backup-stamp")
    if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", readiness_backup_stamp) is None:
        raise OperatorError("Middleware readiness backup reference is malformed")
    database_dump_path = backup / "middleware.dump"
    database_dump_digest, database_dump_size = hash_operator_file(database_dump_path)
    expected_dump_digest = checked_root_file(backup / "middleware.dump.sha256")
    if (
        database_dump_size == 0
        or re.fullmatch(r"[0-9a-f]{64}", expected_dump_digest) is None
        or not hmac.compare_digest(database_dump_digest, expected_dump_digest)
    ):
        raise OperatorError("Middleware rollback database dump checksum mismatch")
    bundle_manifest = {
        "stamp": stamp,
        "release": rollback_target,
        "image_ids": image_ids,
        "override_sha256": override_digest,
        "database_owner": database_owner,
        "database_allows_connections": database_allows_connections,
        "database_connection_limit": database_connection_limit,
        "database_head": database_head,
        "database_clients_running": list(database_clients_running),
        "database_dump_sha256": expected_dump_digest,
        "readiness_backup_stamp": readiness_backup_stamp,
    }
    bundle_digest = hashlib.sha256(
        json.dumps(
            bundle_manifest,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    ).hexdigest()
    return {
        "stamp": stamp,
        "override": override,
        "image_ids": image_ids,
        "database_owner": database_owner,
        "database_allows_connections": database_allows_connections,
        "database_connection_limit": database_connection_limit,
        "database_head": database_head,
        "database_clients_running": database_clients_running,
        "database_dump_path": database_dump_path,
        "database_dump_sha256": expected_dump_digest,
        "readiness_backup_stamp": readiness_backup_stamp,
        "bundle_sha256": bundle_digest,
    }


def middleware_rollback_evidence(bundle: dict[str, object]) -> dict[str, str]:
    stamp = bundle.get("stamp")
    digest = bundle.get("bundle_sha256")
    if (
        not isinstance(stamp, str)
        or re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", stamp) is None
        or not isinstance(digest, str)
        or re.fullmatch(r"[0-9a-f]{64}", digest) is None
    ):
        raise OperatorError("Middleware rollback evidence binding is malformed")
    return {
        "middleware_backup_stamp": stamp,
        "middleware_rollback_bundle_sha256": digest,
    }


def middleware_rollback_progress(backup: Path) -> dict[str, str] | None:
    progress_path = backup / MIDDLEWARE_ROLLBACK_PROGRESS
    if not progress_path.exists():
        if progress_path.is_symlink():
            raise OperatorError("Middleware rollback progress is unsafe")
        return None
    try:
        progress = json.loads(
            checked_operator_bytes(progress_path, expected_mode=0o600).decode("ascii")
        )
    except (UnicodeError, json.JSONDecodeError) as error:
        raise OperatorError("Middleware rollback progress is malformed") from error
    required = {"phase", "failed_state", "failed_state_sha256"}
    if not isinstance(progress, dict) or set(progress) != required:
        raise OperatorError("Middleware rollback progress schema mismatch")
    if progress["phase"] not in {
        "FAILED_STATE_PRESERVED",
        "DATABASE_RESTORED_FENCED",
        "CONNECTION_POLICY_RESTORED",
        "COMPLETE",
    }:
        raise OperatorError("Middleware rollback progress phase is invalid")
    failed_state = progress["failed_state"]
    failed_digest = progress["failed_state_sha256"]
    if (
        not isinstance(failed_state, str)
        or re.fullmatch(r"failed-state-[0-9]{8}T[0-9]{6}Z-[0-9]+\.dump", failed_state) is None
        or not isinstance(failed_digest, str)
        or re.fullmatch(r"[0-9a-f]{64}", failed_digest) is None
    ):
        raise OperatorError("Middleware rollback failed-state reference is malformed")
    actual_failed_digest, failed_size = hash_operator_file(backup / failed_state)
    checksum = checked_operator_bytes(
        backup / f"{failed_state}.sha256", expected_mode=0o600
    ).decode("ascii").strip()
    if (
        failed_size == 0
        or not hmac.compare_digest(actual_failed_digest, failed_digest)
        or not hmac.compare_digest(checksum, failed_digest)
    ):
        raise OperatorError("Middleware rollback failed-state checksum mismatch")
    return {key: str(value) for key, value in progress.items()}


def record_middleware_rollback_progress(
    backup: Path,
    phase: str,
    failed_state: str,
    failed_digest: str,
) -> dict[str, str]:
    progress = {
        "phase": phase,
        "failed_state": failed_state,
        "failed_state_sha256": failed_digest,
    }
    atomic_root_json(
        backup / MIDDLEWARE_ROLLBACK_PROGRESS,
        progress,
        mode=0o600,
    )
    readback = middleware_rollback_progress(backup)
    if readback != progress:
        raise OperatorError("Middleware rollback progress readback mismatch")
    return progress


def prepare_middleware_rollout(stamp: str) -> None:
    """Retire only a completed retry marker before a new rollout attempt."""
    backup = MIDDLEWARE_BACKUP_ROOT / stamp
    progress = middleware_rollback_progress(backup)
    if progress is None:
        return
    if progress["phase"] != "COMPLETE":
        raise OperatorError("Middleware rollback is incomplete; resume rollback before rollout")
    progress_path = backup / MIDDLEWARE_ROLLBACK_PROGRESS
    archived = backup / f"rollback-progress-complete-{time.time_ns()}.json"
    expected = checked_operator_bytes(progress_path, expected_mode=0o600)
    os.replace(progress_path, archived)
    fsync_directory(backup)
    if checked_operator_bytes(archived, expected_mode=0o600) != expected:
        raise OperatorError("Middleware completed rollback archive readback mismatch")


def verify_middleware_rollback_readback(bundle: dict[str, object]) -> str:
    image_ids = bundle["image_ids"]
    if not isinstance(image_ids, dict):
        raise OperatorError("Middleware rollback image map is malformed")
    wait_middleware_health()
    for service, container in MIDDLEWARE_RUNTIME_SERVICES.items():
        current = docker_inspect(container)
        if current.get("Image") != image_ids[service]:
            raise OperatorError(f"Middleware rollback image readback mismatch: {container}")
        environment = dict(
            item.split("=", 1) for item in current["Config"].get("Env", []) if "=" in item
        )
        if any(environment.get(name) != "false" for name in MIDDLEWARE_REQUIRED_FALSE_FLAGS):
            raise OperatorError(f"Middleware rollback delivery flag unsafe: {container}")
    restored_head = middleware_database_revision()
    if restored_head != bundle["database_head"]:
        raise OperatorError("Middleware rollback database head readback mismatch")
    return restored_head


def middleware_database_exists() -> bool:
    result = run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-Atc",
        f"select case when exists(select 1 from pg_database where datname='{MIDDLEWARE_DB}') then 'true' else 'false' end",
    ], timeout=30).stdout.decode().strip()
    if result not in {"true", "false"}:
        raise OperatorError("Middleware database existence readback failed")
    return result == "true"


def set_middleware_database_connection_limit(connection_limit: str) -> None:
    if re.fullmatch(r"-1|[0-9]{1,10}", connection_limit) is None:
        raise OperatorError("Middleware database connection limit is malformed")
    run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        f"alter database {MIDDLEWARE_DB} with connection limit {connection_limit}",
    ], timeout=30)


def fence_middleware_database_clients() -> bool:
    """Block non-superuser writers and terminate existing target sessions."""
    if not middleware_database_exists():
        return False
    run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        f"alter database {MIDDLEWARE_DB} with connection limit 0",
    ], timeout=30)
    run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        f"select pg_terminate_backend(pid) from pg_stat_activity where datname='{MIDDLEWARE_DB}' and pid<>pg_backend_pid()",
    ], timeout=30)
    remaining = run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-Atc",
        f"select count(*) from pg_stat_activity where datname='{MIDDLEWARE_DB}'",
    ], timeout=30).stdout.decode().strip()
    if remaining != "0":
        raise OperatorError("Middleware database sessions remain after fencing")
    return True


def rollback_middleware(config: dict[str, str]) -> dict[str, object]:
    bundle = validate_middleware_rollback(config)
    stamp = str(bundle["stamp"])
    backup = MIDDLEWARE_BACKUP_ROOT / stamp
    progress = middleware_rollback_progress(backup)
    if progress is not None and progress["phase"] == "COMPLETE":
        restored_head = verify_middleware_rollback_readback(bundle)
        return {
            "middleware_rollback_stamp": stamp,
            "middleware_rollback": "PASS",
            "middleware_database_head": restored_head,
            "readiness_backup_stamp": bundle["readiness_backup_stamp"],
            "failed_state_preserved": progress["failed_state"],
            "middleware_rollback_already_complete": True,
        }
    database_clients_running = bundle["database_clients_running"]
    if not isinstance(database_clients_running, tuple):
        raise OperatorError("Middleware database client state is malformed")
    quiesce_middleware_database_clients(stamp)
    compose = middleware_compose(config, rollback_override=bundle["override"])
    run_bytes([
        *compose,
        "stop",
        "--timeout",
        "30",
        *MIDDLEWARE_RUNTIME_SERVICES,
    ], timeout=180)
    database_fenced = False
    if progress is None:
        database_fenced = fence_middleware_database_clients()
        if not database_fenced:
            raise OperatorError(
                "Middleware database missing before failed-state preservation"
            )
        failed_state_name = (
            f"failed-state-{dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
            f"-{os.getpid()}.dump"
        )
        failed_digest, _ = stream_command_to_atomic_file(
            [
                "/usr/bin/docker",
                "exec",
                MIDDLEWARE_DB_CONTAINER,
                "pg_dump",
                "-U",
                "postgres",
                "-Fc",
                MIDDLEWARE_DB,
            ],
            backup / failed_state_name,
            timeout=1800,
        )
        atomic_root_text(
            backup / f"{failed_state_name}.sha256",
            failed_digest + "\n",
            mode=0o600,
        )
        progress = record_middleware_rollback_progress(
            backup,
            "FAILED_STATE_PRESERVED",
            failed_state_name,
            failed_digest,
        )
    if progress["phase"] == "FAILED_STATE_PRESERVED":
        database_exists = database_fenced or fence_middleware_database_clients()
        if database_exists:
            run_bytes([
                "/usr/bin/docker",
                "exec",
                MIDDLEWARE_DB_CONTAINER,
                "psql",
                "-U",
                "postgres",
                "-d",
                "postgres",
                "-v",
                "ON_ERROR_STOP=1",
                "-c",
                f"alter database {MIDDLEWARE_DB} with allow_connections false",
            ], timeout=30)
        run_bytes([
            "/usr/bin/docker", "exec", MIDDLEWARE_DB_CONTAINER,
            "dropdb", "-U", "postgres", "--if-exists", MIDDLEWARE_DB,
        ], timeout=60)
        run_bytes([
            "/usr/bin/docker",
            "exec",
            MIDDLEWARE_DB_CONTAINER,
            "psql",
            "-U",
            "postgres",
            "-d",
            "postgres",
            "-v",
            "ON_ERROR_STOP=1",
            "-c",
            f"create database {MIDDLEWARE_DB} with owner {bundle['database_owner']} connection limit 0",
        ], timeout=60)
        database_dump_path = bundle["database_dump_path"]
        database_dump_digest = bundle["database_dump_sha256"]
        if not isinstance(database_dump_path, Path) or not isinstance(database_dump_digest, str):
            raise OperatorError("Middleware rollback database stream is malformed")
        run_with_verified_file_stdin(
            [
                "/usr/bin/docker", "exec", "-i", MIDDLEWARE_DB_CONTAINER,
                "pg_restore", "-U", "postgres", "--exit-on-error", "-d", MIDDLEWARE_DB,
            ],
            database_dump_path,
            database_dump_digest,
            timeout=1800,
        )
        progress = record_middleware_rollback_progress(
            backup,
            "DATABASE_RESTORED_FENCED",
            progress["failed_state"],
            progress["failed_state_sha256"],
        )
    if progress["phase"] == "DATABASE_RESTORED_FENCED":
        set_middleware_database_connection_limit(
            str(bundle["database_connection_limit"])
        )
        run_bytes([
            "/usr/bin/docker",
            "exec",
            MIDDLEWARE_DB_CONTAINER,
            "psql",
            "-U",
            "postgres",
            "-d",
            "postgres",
            "-v",
            "ON_ERROR_STOP=1",
            "-c",
            f"alter database {MIDDLEWARE_DB} with allow_connections {bundle['database_allows_connections']}",
        ], timeout=30)
        progress = record_middleware_rollback_progress(
            backup,
            "CONNECTION_POLICY_RESTORED",
            progress["failed_state"],
            progress["failed_state_sha256"],
        )
    if progress["phase"] != "CONNECTION_POLICY_RESTORED":
        raise OperatorError("Middleware rollback connection policy is not restored")
    run_bytes([
        *compose,
        "up",
        "--detach",
        "--no-deps",
        "--force-recreate",
        *MIDDLEWARE_RUNTIME_SERVICES,
    ], timeout=600)
    restored_head = verify_middleware_rollback_readback(bundle)
    resume_middleware_database_clients(stamp, database_clients_running)
    progress = record_middleware_rollback_progress(
        backup,
        "COMPLETE",
        progress["failed_state"],
        progress["failed_state_sha256"],
    )
    return {
        "middleware_rollback_stamp": stamp,
        "middleware_rollback": "PASS",
        "middleware_database_head": restored_head,
        "readiness_backup_stamp": bundle["readiness_backup_stamp"],
        "failed_state_preserved": progress["failed_state"],
    }


def middleware_runtime_image_matches(config: dict[str, str]) -> list[bool]:
    expected = f"{MIDDLEWARE_IMAGE}@{config['image_digest']}"
    return [
        docker_inspect(container)["Config"].get("Image") == expected
        for container in MIDDLEWARE_RUNTIME_CONTAINERS
    ]


def middleware_database_head() -> str:
    return run_bytes([
        "/usr/bin/docker",
        "exec",
        MIDDLEWARE_RUNTIME_SERVICES["middleware-integration-api"],
        "alembic",
        "current",
    ], timeout=60).stdout.decode()


def middleware_database_revision() -> str:
    output = middleware_database_head().strip()
    revision = output.split(maxsplit=1)[0] if output else ""
    if re.fullmatch(r"[0-9a-z_]{1,80}", revision) is None:
        raise OperatorError("Middleware database revision readback failed")
    return revision


def rollout_middleware(config: dict[str, str]) -> dict[str, object]:
    """Migrate and replace only the three approved Middleware runtimes."""
    require_action_evidence("stage", config)
    require_action_evidence("stage-control-plane", config)
    require_action_evidence("validate-backup", config)
    restore_evidence = require_action_evidence("restore-test", config)
    backup_state = validate_backup_state()
    require_evidence_value(
        restore_evidence,
        "tested_backup_stamp",
        backup_state["backup_stamp"],
    )
    require_evidence_value(
        restore_evidence,
        "isolated_middleware_migration",
        "PASS",
    )
    require_evidence_value(
        restore_evidence,
        "tested_middleware_database_head",
        MIDDLEWARE_REQUIRED_DATABASE_HEAD,
    )
    certify_standby(config)
    compose = middleware_compose(config)
    validate_middleware_compose(config, compose)
    image_matches = middleware_runtime_image_matches(config)
    if all(image_matches):
        stamp = snapshot_middleware_runtime(config, str(backup_state["backup_stamp"]))
        try:
            bundle = validate_middleware_rollback(config)
            captured_clients = bundle["database_clients_running"]
            if not isinstance(captured_clients, tuple):
                raise OperatorError("Middleware database client state is malformed")
            quiescence_stamp = middleware_quiescence_stamp()
            if quiescence_stamp is not None:
                if quiescence_stamp != stamp:
                    raise OperatorError(
                        "Middleware quiescence marker does not match rollback point"
                    )
                resume_middleware_database_clients(stamp, captured_clients)
                wait_middleware_health()
        except Exception:
            recover_stale_middleware_quiescence()
            raise
    elif any(image_matches):
        bundle = validate_middleware_rollback(config)
        stamp = str(bundle["stamp"])
    else:
        stamp = snapshot_middleware_runtime(config, str(backup_state["backup_stamp"]))
        bundle = validate_middleware_rollback(config)
    database_clients_running = bundle["database_clients_running"]
    if not isinstance(database_clients_running, tuple):
        raise OperatorError("Middleware database client state is malformed")
    if all(image_matches):
        runtime = verify_middleware_runtime(config)
        if middleware_database_revision() != MIDDLEWARE_REQUIRED_DATABASE_HEAD:
            raise OperatorError("Middleware database head readback mismatch")
        return {
            **runtime,
            **middleware_rollback_evidence(bundle),
            "middleware_database_head": MIDDLEWARE_REQUIRED_DATABASE_HEAD,
            "middleware_rollout": "PASS",
            "middleware_already_current": True,
        }
    if middleware_quiescence_stamp() != stamp:
        raise OperatorError("Middleware database clients are not quiesced for rollout")
    prepare_middleware_rollout(stamp)
    try:
        run_bytes([
            *compose,
            "run",
            "--rm",
            "--no-deps",
            "middleware-integration-api",
            "alembic",
            "upgrade",
            "head",
        ], timeout=1800)
        run_bytes([
            *compose,
            "up",
            "--detach",
            "--no-deps",
            "--force-recreate",
            *MIDDLEWARE_RUNTIME_SERVICES,
        ], timeout=600)
        wait_middleware_health()
        runtime = verify_middleware_runtime(config)
        if middleware_database_revision() != MIDDLEWARE_REQUIRED_DATABASE_HEAD:
            raise OperatorError("Middleware database head readback mismatch")
        resume_middleware_database_clients(stamp, database_clients_running)
    except Exception:
        rollback_middleware(config)
        raise
    return {
        **runtime,
        **middleware_rollback_evidence(bundle),
        "middleware_database_head": MIDDLEWARE_REQUIRED_DATABASE_HEAD,
        "middleware_rollout": "PASS",
    }


def load_pointer(path: Path) -> dict[str, object] | None:
    if not path.exists():
        return None
    raw = checked_root_file(path, expected_mode=0o644)
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as error:
        raise OperatorError(f"state pointer malformed: {path}") from error
    if not isinstance(value, dict):
        raise OperatorError(f"state pointer malformed: {path}")
    return value


def activate_control_plane(config: dict[str, str]) -> dict[str, object]:
    """Commit the exact staged tuple only after every recovery gate passes."""
    database_certification = validate_database_certification()
    stage_evidence = require_action_evidence("stage-control-plane", config)
    validation_evidence = require_action_evidence("validate-control-plane", config)
    restore_evidence = require_action_evidence("restore-test", config)
    middleware_evidence = require_action_evidence("rollout-middleware", config)
    backup = validate_backup_state()
    require_evidence_value(
        restore_evidence,
        "tested_backup_stamp",
        backup["backup_stamp"],
    )
    rollback = validate_control_plane_rollback()
    middleware_rollback = validate_middleware_rollback(config)
    for key, expected in middleware_rollback_evidence(middleware_rollback).items():
        require_evidence_value(middleware_evidence, key, expected)
    previous = load_pointer(ACTIVE_RELEASE_POINTER)
    if previous is not None:
        atomic_root_json(PREVIOUS_RELEASE_POINTER, previous)
    try:
        control_plane = validate_control_plane(config)
        middleware = verify_middleware_runtime(config)
        active = {
            "protected_sha": config["protected_sha"],
            "image_digest": config["image_digest"],
            "change_id": config["change_id"],
            "activated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "stage_evidence": stage_evidence.name,
            "validation_evidence": validation_evidence.name,
            "restore_evidence": restore_evidence.name,
            "middleware_evidence": middleware_evidence.name,
            "backup_stamp": backup["backup_stamp"],
            "rollback_stamp": rollback["rollback_stamp"],
            "middleware_backup_stamp": middleware_rollback["stamp"],
            "middleware_rollback_bundle_sha256": middleware_rollback["bundle_sha256"],
        }
        atomic_root_json(ACTIVE_RELEASE_POINTER, active)
    except Exception:
        rollback_control_plane(config)
        raise
    return {
        **control_plane,
        **middleware,
        **database_certification,
        "active_platform_sha": config["protected_sha"],
        "active_middleware_digest": config["image_digest"],
        "rollback_ready": "PASS",
    }


def core_web_health(config: dict[str, str]) -> dict[str, object]:
    validate_database_certification()
    active = load_pointer(ACTIVE_RELEASE_POINTER)
    if not active or active.get("protected_sha") != config["protected_sha"] or active.get("image_digest") != config["image_digest"]:
        raise OperatorError("exact control-plane release is not active")
    validate_control_plane(config)
    verify_middleware_runtime(config)
    for container in ("codestra-postgres-1", "codestra-identity-keycloak-1", "codestra-kong-kong-gateway-1", "codestra-odoo-1"):
        current = docker_inspect(container)
        health = current["State"].get("Health", {}).get("Status")
        if health != "healthy" or not current["State"].get("Running"):
            raise OperatorError(f"core web dependency unhealthy: {container}")
    probe_auth_gateway()
    probe_core_web({401, 503})
    return {
        "core_web_dependencies": "PASS",
        "auth_gateway_readiness": "PASS",
        "caddy_serving_path": "PASS",
    }


def validate_database_certification() -> dict[str, str]:
    """Require checksum-bound evidence for every production persistence authority."""
    result = run_fixed(
        [
            str(DATABASE_MANIFEST_VALIDATOR),
            str(DATABASE_MANIFEST),
            str(DATABASE_EVIDENCE_ROOT),
        ],
        timeout=30,
    )
    if result.returncode != 0 or "PRODUCTION_DATABASE_MANIFEST=PASS" not in result.stdout:
        raise OperatorError("production database certification is not PASS")
    manifest = checked_root_file(DATABASE_MANIFEST, expected_mode=0o644)
    if not re.search(r"(?m)^certification_status: PASS$", manifest):
        raise OperatorError("production database certification is not PASS")
    return {"production_database_certification": "PASS"}


def kong_json(method: str, path: str, payload: dict[str, object] | None = None) -> dict[str, object]:
    body = None if payload is None else json.dumps(payload, separators=(",", ":")).encode()
    request = urllib.request.Request(
        KONG_ADMIN_URL + path,
        data=body,
        method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            raw = response.read(1024 * 1024)
    except (OSError, urllib.error.URLError, urllib.error.HTTPError) as error:
        raise OperatorError("Kong traffic gate reconciliation failed") from error
    try:
        result = json.loads(raw or b"{}")
    except json.JSONDecodeError as error:
        raise OperatorError("Kong traffic gate returned invalid JSON") from error
    if not isinstance(result, dict):
        raise OperatorError("Kong traffic gate returned invalid data")
    return result


def kong_traffic_gate(enabled: bool) -> None:
    plugins = kong_json("GET", "/plugins?size=1000").get("data", [])
    matches = [
        item for item in plugins
        if item.get("name") == "request-termination"
        and item.get("instance_name") == KONG_TRAFFIC_GATE_INSTANCE
    ]
    if len(matches) > 1:
        raise OperatorError("duplicate Kong core traffic gates")
    current = matches[0] if matches else None
    if enabled and current is None:
        current = kong_json("POST", "/plugins", {
            "name": "request-termination",
            "instance_name": KONG_TRAFFIC_GATE_INSTANCE,
            "enabled": True,
            "config": {"status_code": 503, "message": "core_web_api_maintenance"},
            "tags": ["codestra-managed", "core-web-api-traffic-gate"],
        })
    elif not enabled and current is not None:
        request = urllib.request.Request(
            KONG_ADMIN_URL + f"/plugins/{current['id']}", method="DELETE"
        )
        try:
            with urllib.request.urlopen(request, timeout=15) as response:
                if response.status != 204:
                    raise OperatorError("Kong traffic gate delete failed")
        except (OSError, urllib.error.URLError, urllib.error.HTTPError) as error:
            raise OperatorError("Kong traffic gate delete failed") from error
    readback = kong_json("GET", "/plugins?size=1000").get("data", [])
    present = any(
        item.get("name") == "request-termination"
        and item.get("instance_name") == KONG_TRAFFIC_GATE_INSTANCE
        and item.get("enabled") is True
        and item.get("config", {}).get("status_code") == 503
        for item in readback
    )
    if present != enabled:
        raise OperatorError("Kong traffic gate readback mismatch")


def kong_runtime_readback() -> dict[str, object]:
    """Return an allowlisted, credential-free view of Kong runtime authority."""
    routes = kong_json("GET", "/routes?size=1000").get("data", [])
    services = kong_json("GET", "/services?size=1000").get("data", [])
    upstreams = kong_json("GET", "/upstreams?size=1000").get("data", [])
    plugins = kong_json("GET", "/plugins?size=1000").get("data", [])
    if not all(isinstance(items, list) for items in (routes, services, upstreams, plugins)):
        raise OperatorError("Kong runtime readback returned invalid collections")

    safe_routes = sorted(
        (
            {
                "id": item.get("id"),
                "name": item.get("name"),
                "service_id": (item.get("service") or {}).get("id"),
                "protocols": item.get("protocols") or [],
                "methods": item.get("methods") or [],
                "hosts": item.get("hosts") or [],
                "paths": item.get("paths") or [],
                "strip_path": item.get("strip_path"),
                "preserve_host": item.get("preserve_host"),
            }
            for item in routes
            if isinstance(item, dict)
        ),
        key=lambda item: str(item["name"] or item["id"]),
    )
    safe_services = sorted(
        (
            {
                "id": item.get("id"),
                "name": item.get("name"),
                "protocol": item.get("protocol"),
                "host": item.get("host"),
                "port": item.get("port"),
                "path": item.get("path"),
                "retries": item.get("retries"),
                "connect_timeout": item.get("connect_timeout"),
                "read_timeout": item.get("read_timeout"),
                "write_timeout": item.get("write_timeout"),
                "enabled": item.get("enabled"),
            }
            for item in services
            if isinstance(item, dict)
        ),
        key=lambda item: str(item["name"] or item["id"]),
    )
    safe_upstreams: list[dict[str, object]] = []
    for item in upstreams:
        if not isinstance(item, dict):
            continue
        upstream_id = item.get("id")
        health = kong_json("GET", f"/upstreams/{upstream_id}/health")
        health_items = health.get("data", [])
        if not isinstance(health_items, list):
            raise OperatorError("Kong upstream health returned invalid data")
        safe_upstreams.append(
            {
                "id": upstream_id,
                "name": item.get("name"),
                "algorithm": item.get("algorithm"),
                "targets": sorted(
                    (
                        {
                            "id": target.get("id"),
                            "target": target.get("target"),
                            "weight": target.get("weight"),
                            "health": target.get("health"),
                        }
                        for target in health_items
                        if isinstance(target, dict)
                    ),
                    key=lambda target: str(target["target"] or target["id"]),
                ),
            }
        )
    safe_upstreams.sort(key=lambda item: str(item["name"] or item["id"]))
    safe_plugins = sorted(
        (
            {
                "id": item.get("id"),
                "name": item.get("name"),
                "instance_name": item.get("instance_name"),
                "enabled": item.get("enabled"),
                "route_id": (item.get("route") or {}).get("id"),
                "service_id": (item.get("service") or {}).get("id"),
                "consumer_id": (item.get("consumer") or {}).get("id"),
            }
            for item in plugins
            if isinstance(item, dict)
        ),
        key=lambda item: str(item["instance_name"] or item["name"] or item["id"]),
    )
    traffic_gate = any(
        item["name"] == "request-termination"
        and item["instance_name"] == KONG_TRAFFIC_GATE_INSTANCE
        and item["enabled"] is True
        for item in safe_plugins
    )
    sanitized = {
        "routes": safe_routes,
        "services": safe_services,
        "upstreams": safe_upstreams,
        "plugins": safe_plugins,
        "core_web_traffic_gate_present": traffic_gate,
    }
    checksum = hashlib.sha256(
        json.dumps(sanitized, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    return {
        **sanitized,
        "route_count": len(safe_routes),
        "service_count": len(safe_services),
        "upstream_count": len(safe_upstreams),
        "plugin_count": len(safe_plugins),
        "sanitized_configuration_sha256": checksum,
    }


def probe_auth_gateway() -> None:
    current = docker_inspect(AUTH_GATEWAY_CONTAINER)
    if not current["State"].get("Running"):
        raise OperatorError("auth gateway is not running")
    network = current.get("NetworkSettings", {}).get("Networks", {}).get(
        AUTH_GATEWAY_NETWORK
    )
    if not isinstance(network, dict):
        raise OperatorError("auth gateway private network is unavailable")
    raw_address = network.get("IPAddress")
    try:
        address = ipaddress.ip_address(raw_address)
    except ValueError as error:
        raise OperatorError("auth gateway private address is invalid") from error
    if not any(address in network for network in RFC1918_NETWORKS):
        raise OperatorError("auth gateway address is not private")
    request = urllib.request.Request(
        f"http://{address}:{AUTH_GATEWAY_PORT}/ping", method="GET"
    )
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            status_code = response.status
    except (OSError, urllib.error.URLError, urllib.error.HTTPError) as error:
        raise OperatorError("auth gateway readiness probe failed") from error
    if status_code != 200:
        raise OperatorError("auth gateway readiness probe failed")


def probe_core_web(expected: int | set[int]) -> None:
    request = urllib.request.Request(CORE_WEB_PROBE_URL, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            status_code = response.status
    except urllib.error.HTTPError as error:
        status_code = error.code
    except (OSError, urllib.error.URLError) as error:
        raise OperatorError("core Web/API probe failed") from error
    expected_statuses = {expected} if isinstance(expected, int) else expected
    if status_code not in expected_statuses:
        raise OperatorError("core Web/API serving-state readback mismatch")


def set_core_web_traffic(config: dict[str, str], enabled: bool) -> dict[str, object]:
    health = core_web_health(config) if enabled else {}
    try:
        kong_traffic_gate(not enabled)
        probe_core_web(401 if enabled else 503)
        atomic_root_json(
            CORE_WEB_TRAFFIC_POINTER,
            {
                "enabled": enabled,
                "protected_sha": config["protected_sha"],
                "image_digest": config["image_digest"],
                "customer_wide_email": False,
                "sms_production": False,
                "voice_production": False,
                "pstn_dialing": False,
                "updated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            },
        )
    except Exception:
        if enabled:
            kong_traffic_gate(True)
        raise
    return {
        **health,
        "core_web_api_traffic": "ENABLED" if enabled else "DISABLED",
        "customer_communications": "DISABLED",
    }


def safety_state() -> dict[str, object]:
    channel = run_fixed(
        ["/usr/bin/ssh", "codestra-vicidial", VICIDIAL_CHANNELS_COMMAND]
    )
    registrations = run_fixed(
        ["/usr/bin/ssh", "codestra-vicidial", VICIDIAL_REGISTRATIONS_COMMAND]
    )
    runtime = run_fixed(
        [
            "/usr/bin/docker",
            "inspect",
            "codestra-middleware-1",
            "--format",
            "{{json .Config.Env}}",
        ]
    )
    runtime_flags: dict[str, str] = {}
    if runtime.returncode == 0:
        try:
            for entry in json.loads(runtime.stdout):
                name, separator, value = entry.partition("=")
                if separator:
                    runtime_flags[name] = value
        except (json.JSONDecodeError, TypeError):
            runtime_flags = {}
    flags_false = all(
        runtime_flags.get(name) == "false" for name in CANONICAL_FALSE_FLAGS
    )
    calls = re.findall(r"(?m)^([0-9]+) active calls$", channel.stdout)
    channels = re.findall(r"(?m)^([0-9]+) active channels$", channel.stdout)
    return {
        "pstatus": run_fixed(["/usr/bin/systemctl", "is-system-running"]).returncode,
        "telephony_probe_pass": channel.returncode == 0 and registrations.returncode == 0,
        "active_calls_zero": calls == ["0"],
        "active_channels_zero": channels == ["0"],
        "required_runtime_flags_false": flags_false,
        "sip_registration_performed": "No objects found." not in registrations.stdout,
    }


def recovery_safety_state() -> dict[str, object]:
    """Keep recovery callable without waiting on fallible remote safety probes."""
    return {
        "probe_status": "SKIPPED_FOR_RECOVERY",
        "telephony_probe_pass": False,
        "active_calls_zero": False,
        "active_channels_zero": False,
        "required_runtime_flags_false": False,
        "sip_registration_performed": False,
    }


def execute(action: str) -> tuple[int, dict[str, object]]:
    if action not in ALLOWED_ACTIONS:
        raise OperatorError("action is not allowlisted")
    config = load_release_config()
    window: dict[str, str] | None = None
    if action not in READ_ONLY_ACTIONS | RECOVERY_ACTIONS:
        window = require_maintenance_window()
        if window["maintenance_date"] != config["maintenance_date"]:
            raise OperatorError("maintenance date does not match release tuple")
    elif action in READ_ONLY_ACTIONS:
        try:
            window = require_maintenance_window()
        except OperatorError:
            window = {
                "maintenance_date": config["maintenance_date"],
                "maintenance_window": "OUTSIDE_APPROVED_WINDOW",
                "owner_window_waiver_evidence": "FAIL",
                "window_check": "DENIED",
            }
    state = recovery_safety_state() if action in RECOVERY_ACTIONS else safety_state()
    safe_for_activation = (
        state["telephony_probe_pass"]
        and state["active_calls_zero"]
        and state["active_channels_zero"]
        and state["required_runtime_flags_false"]
        and not state["sip_registration_performed"]
    )
    if action not in SAFETY_BYPASS_ACTIONS and not safe_for_activation:
        raise OperatorError("runtime safety state is not fail-closed")
    result: dict[str, object] = {
        "action": action,
        "maintenance_date": None if window is None else window["maintenance_date"],
        "window": window,
        "release": config,
        "safety": state,
    }
    if action in SYSTEMD_ACTIONS:
        unit = SYSTEMD_ACTIONS[action]
        restore_backup_before = validate_backup_state() if action == "restore-test" else None
        if restore_backup_before is not None:
            require_action_evidence("stage", config)
            certify_standby(config)
        invocation = run_fixed(["/usr/bin/systemctl", "start", "--wait", unit])
        result.update({"unit": unit, "returncode": invocation.returncode})
        if invocation.returncode != 0:
            raise OperatorError(f"fixed unit failed: {unit}")
        if restore_backup_before is not None:
            restore_backup_after = validate_backup_state()
            if restore_backup_after["backup_stamp"] != restore_backup_before["backup_stamp"]:
                raise OperatorError("readiness backup changed during restore test")
            result.update(
                validate_restore_result(
                    str(restore_backup_before["backup_stamp"]), config
                )
            )
    elif action == "validate-backup":
        result.update(validate_backup_state())
    elif action == "stage":
        result.update(stage_standby(config))
    elif action == "canary":
        result.update(certify_standby(config))
    elif action == "rollback":
        result.update(remove_standby(config))
    elif action == "stage-control-plane":
        result.update(stage_control_plane(config))
    elif action == "validate-control-plane":
        result.update(validate_control_plane(config))
    elif action == "kong-readback":
        result.update(kong_runtime_readback())
    elif action == "rollback-control-plane":
        result.update(rollback_control_plane(config))
    elif action == "rollout-middleware":
        result.update(rollout_middleware(config))
    elif action == "rollback-middleware":
        result.update(rollback_middleware(config))
    elif action == "activate-control-plane":
        result.update(activate_control_plane(config))
    elif action == "enable-production-web-traffic":
        result.update(set_core_web_traffic(config, True))
    elif action == "disable-production-web-traffic":
        result.update(set_core_web_traffic(config, False))
    elif action == "enable-klyrow-email-delivery":
        result.update(set_klyrow_email_delivery(config, True))
    elif action == "disable-klyrow-email-delivery":
        result.update(set_klyrow_email_delivery(config, False))
    elif action in {"preflight", "status"}:
        invocation = run_fixed(["/usr/bin/systemctl", "--failed", "--no-legend", "--plain"])
        result.update({"returncode": invocation.returncode, "failed_units_present": bool(invocation.stdout.strip())})
        if action == "preflight" and result["failed_units_present"]:
            raise OperatorError("preflight found failed units")
    else:
        invocation = run_fixed(["/usr/bin/docker", "ps", "--format", "{{.Names}}|{{.Image}}|{{.Status}}"])
        result.update({"returncode": invocation.returncode, "container_inventory_collected": invocation.returncode == 0})
        if invocation.returncode != 0:
            raise OperatorError("evidence collection failed")
    return 0, result


def write_evidence(action: str, status_value: str, detail: dict[str, object]) -> Path:
    EVIDENCE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = EVIDENCE_DIR.lstat()
    if (
        stat.S_ISLNK(info.st_mode)
        or info.st_uid != 0
        or info.st_gid != 0
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise OperatorError("evidence directory is unsafe")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    target = EVIDENCE_DIR / f"{stamp}-{os.getpid()}-{action}.json"
    payload = {"schema": "codestra.production-operator.v1", "status": status_value, **detail}
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        json.dump(payload, stream, sort_keys=True, separators=(",", ":"))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    return target


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("operator rejected: root execution required", file=sys.stderr)
        return 2
    if len(argv) != 1 or argv[0] not in ALLOWED_ACTIONS:
        print("operator rejected: exactly one allowlisted action is required", file=sys.stderr)
        return 2
    action = argv[0]
    LOCK_FILE.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    descriptor = os.open(
        LOCK_FILE,
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    with os.fdopen(descriptor, "a+", encoding="ascii") as lock:
        lock_info = os.fstat(lock.fileno())
        if lock_info.st_uid != 0 or stat.S_IMODE(lock_info.st_mode) != 0o600:
            print("operator rejected: unsafe lock file", file=sys.stderr)
            return 2
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            _, result = execute(action)
            evidence = write_evidence(action, "PASS", result)
            print(f"OPERATOR_RESULT=PASS\nACTION={action}\nEVIDENCE={evidence}")
            return 0
        except Exception as error:
            detail = {"action": action, "error_class": type(error).__name__}
            try:
                evidence = write_evidence(action, "FAIL", detail)
                print(f"EVIDENCE={evidence}", file=sys.stderr)
            except Exception:
                pass
            print(f"operator rejected: {type(error).__name__}", file=sys.stderr)
            return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
