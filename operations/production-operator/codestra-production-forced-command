#!/bin/sh
set -eu

action=$(/usr/bin/python3 -c '
import json, os, re, stat, sys
raw = os.environ.get("SSH_ORIGINAL_COMMAND", "")
parts = raw.split(" ")
allowed = {
    "preflight", "backup", "validate-backup", "restore-test", "stage",
    "canary", "status", "rollback", "collect-evidence", "kong-readback",
    "stage-control-plane", "validate-control-plane", "rollback-control-plane",
    "rollout-middleware", "rollback-middleware",
    "activate-control-plane", "enable-production-web-traffic", "disable-production-web-traffic",
    "enable-klyrow-email-delivery", "disable-klyrow-email-delivery",
}
if len(parts) != 5 or parts[0] not in allowed:
    raise SystemExit(2)
patterns = (r"[0-9a-f]{40}", r"sha256:[0-9a-f]{64}", r"CHG-[0-9]{8}-CODESTRA-PRODUCTION-ACTIVATION-[0-9]{2}", r"20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])")
if any(re.fullmatch(pattern, value) is None for pattern, value in zip(patterns, parts[1:])):
    raise SystemExit(2)
path = "/etc/codestra/production-operator/release.json"
info = os.lstat(path)
if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o644:
    raise SystemExit(2)
with open(path, encoding="ascii") as stream:
    config = json.load(stream)
expected = [config.get(key) for key in ("protected_sha", "image_digest", "change_id", "maintenance_date")]
if parts[1:] != expected or set(config) != {"protected_sha", "image_digest", "change_id", "maintenance_date"}:
    raise SystemExit(2)
print(parts[0])
') || {
  echo "restricted operator: exactly one allowlisted action and the installed release tuple are required" >&2
  exit 2
}

exec /usr/bin/sudo -n /usr/local/sbin/codestra-production-operator "$action"
