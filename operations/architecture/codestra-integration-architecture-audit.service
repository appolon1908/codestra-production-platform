[Unit]
Description=Codestra integration architecture fail-closed audit
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/codestra/integration-constitution/current/operations/architecture/run-integration-architecture-audit.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codestra-integration-architecture /var/lib/node_exporter/textfile_collector
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
