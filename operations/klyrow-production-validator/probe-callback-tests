#!/usr/bin/python3
"""Fixed rejected-callback probes; valid signing authority is never read here."""

from __future__ import annotations

import json
import time

from kpv_probe_core import emit, request_status


BODY = json.dumps(
    {
        "event": "email.delivered",
        "message_id": "00000000-0000-0000-0000-000000000000",
        "tenant_id": "00000000-0000-0000-0000-000000000000",
        "recipient": "synthetic@invalid",
        "provider": "synthetic",
        "status": "delivered",
    },
    separators=(",", ":"),
).encode("utf-8")


def main() -> int:
    current_timestamp = str(int(time.time()))
    cases = (
        (
            "invalid_signature",
            {
                "Content-Type": "application/json",
                "X-Klyrow-Timestamp": current_timestamp,
                "X-Klyrow-Event-Id": "00000000-0000-0000-0000-000000000000",
                "X-Klyrow-Signature": "invalid",
            },
        ),
        (
            "missing_event_id",
            {
                "Content-Type": "application/json",
                "X-Klyrow-Timestamp": current_timestamp,
                "X-Klyrow-Signature": "invalid",
            },
        ),
    )
    results = []
    for test_id, headers in cases:
        result = request_status("POST", "/v1/webhooks/postal", headers=headers, body=BODY)
        result.update({"test_id": test_id, "denied": result.get("status") in {400, 401, 403, 422}})
        results.append(result)
    negative_tests_passed = all(result["denied"] for result in results)
    emit(
        {
            "rejected_callback_tests": results,
            "negative_tests_passed": negative_tests_passed,
            "complete": False,
            "valid_signature_test": "NOT_RUN_REQUIRES_SEPARATE_SIGNING_AUTHORITY",
            "durable_state_expected": False,
        }
    )
    return 3


if __name__ == "__main__":
    raise SystemExit(main())
